@@ -0,0 +1,239 @@
+"use client";
+
+import { useMemo, useState, type ReactNode } from "react";
+import { Plus, X } from "lucide-react";
+import { toast } from "sonner";
+import { Checkbox } from "@/components/ui/checkbox";
+import { NativeSelect } from "@/components/ui/native-select";
+import { Mono } from "@/components/shared/mono";
+import { isApiError } from "@/lib/api-error";
+import { includesNormalized } from "@/lib/i18n/normalize";
+import { cn } from "@/lib/utils";
+import { categoryPath } from "@/features/organization/schemas";
+import { orgApi, useBadges, useBrands, useCategories, useCollections, useInvalidateOrganization, useTags } from "@/features/organization/api";
+import { CategoryEditorSheet } from "@/features/organization/components/category-editor-sheet";
+
+/**
+ * Organization pickers inside the product editor (M05 FR-05.04/05.06/05.12): categories by
+ * their full path «إلكترونيات ⟵ هواتف», tags created by typing + Enter from right here,
+ * badges as a dot + text, collections as checkboxes — all from the same M05 cache.
+ */
+export function CategoryPicker({
+  value,
+  onChange,
+  disabled,
+}: {
+  value: string;
+  onChange: (next: string) => void;
+  disabled?: boolean;
+}) {
+  const query = useCategories();
+  const categories = useMemo(() => query.data ?? [], [query.data]);
+  const [creating, setCreating] = useState(false);
+  const byId = useMemo(() => new Map(categories.map((c) => [c.id, c])), [categories]);
+  const options = categories
+    .map((c) => ({ id: c.id, label: categoryPath(c.id, byId) }))
+    .sort((a, b) => a.label.localeCompare(b.label, "ar"));
+  return (
+    <div className="flex flex-col gap-1.5">
+      <div className="flex gap-2">
+        <NativeSelect
+          id="pe-category"
+          value={value}
+          disabled={disabled}
+          onChange={(e) => onChange(e.target.value)}
+          className="h-11 md:h-8"
+          data-testid="product-category"
+        >
+          <option value="">بلا تصنيف</option>
+          {options.map((o) => (
+            <option key={o.id} value={o.id}>
+              {o.label}
+            </option>
+          ))}
+        </NativeSelect>
+        {!disabled ? (
+          <button
+            type="button"
+            onClick={() => setCreating(true)}
+            aria-label="تصنيف جديد"
+            title="تصنيف جديد"
+            className="flex size-11 shrink-0 items-center justify-center rounded-lg border border-border hover:bg-muted md:size-8"
+          >
+            <Plus className="size-4" aria-hidden />
+          </button>
+        ) : null}
+      </div>
+      <CategoryEditorSheet
+        open={creating}
+        onOpenChange={setCreating}
+        category={null}
+        onSaved={(c) => onChange(String(c.id))}
+      />
+    </div>
+  );
+}
+
+export function BrandPicker({ value, onChange, disabled }: { value: string; onChange: (v: string) => void; disabled?: boolean }) {
+  const brands = useBrands().data ?? [];
+  return (
+    <NativeSelect id="pe-brand" value={value} disabled={disabled} onChange={(e) => onChange(e.target.value)} className="h-11 md:h-8">
+      <option value="">بلا ماركة</option>
+      {brands.map((b) => (
+        <option key={b.id} value={b.id}>
+          {b.name}
+        </option>
+      ))}
+    </NativeSelect>
+  );
+}
+
+export function TagPicker({ value, onChange, disabled }: { value: number[]; onChange: (v: number[]) => void; disabled?: boolean }) {
+  const tags = useTags().data ?? [];
+  const invalidate = useInvalidateOrganization();
+  const [draft, setDraft] = useState("");
+  const [busy, setBusy] = useState(false);
+  const selected = tags.filter((t) => value.includes(t.id));
+  const suggestions = draft ? tags.filter((t) => !value.includes(t.id) && includesNormalized(t.name, draft)).slice(0, 6) : [];
+
+  async function commit() {
+    const name = draft.trim();
+    if (!name) return;
+    const existing = tags.find((t) => t.name === name);
+    if (existing) {
+      if (!value.includes(existing.id)) onChange([...value, existing.id]);
+      setDraft("");
+      return;
+    }
+    setBusy(true);
+    try {
+      const tag = await orgApi.saveTag(null, { name });
+      onChange([...value, tag.id]);
+      setDraft("");
+      await invalidate();
+    } catch (err) {
+      toast.error(isApiError(err) ? err.userMessage : "تعذّر إنشاء الوسم.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="flex flex-col gap-2">
+      {selected.length ? (
+        <ul className="flex flex-wrap gap-1.5">
+          {selected.map((t) => (
+            <li key={t.id} className="inline-flex items-center gap-1 rounded-md border border-border ps-2 text-sm">
+              {t.name}
+              {!disabled ? (
+                <button
+                  type="button"
+                  onClick={() => onChange(value.filter((x) => x !== t.id))}
+                  aria-label={`إزالة الوسم ${t.name}`}
+                  className="flex size-11 items-center justify-center text-muted-foreground hover:text-foreground lg:size-6"
+                >
+                  <X className="size-3" aria-hidden />
+                </button>
+              ) : null}
+            </li>
+          ))}
+        </ul>
+      ) : null}
+      {!disabled ? (
+        <div className="relative">
+          <input
+            value={draft}
+            onChange={(e) => setDraft(e.target.value)}
+            onKeyDown={(e) => {
+              if (e.key === "Enter") {
+                e.preventDefault();
+                void commit();
+              }
+            }}
+            disabled={busy}
+            placeholder="اكتب وسماً ثم Enter"
+            aria-label="إضافة وسم"
+            className="h-11 w-full rounded-lg border border-input bg-background px-2.5 text-base outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:h-8 md:text-sm"
+            data-testid="tag-input"
+          />
+          {suggestions.length ? (
+            <ul className="absolute inset-x-0 top-full z-20 mt-1 rounded-lg border border-border bg-popover p-1">
+              {suggestions.map((t) => (
+                <li key={t.id}>
+                  <button
+                    type="button"
+                    onClick={() => {
+                      onChange([...value, t.id]);
+                      setDraft("");
+                    }}
+                    className="flex min-h-11 w-full items-center justify-between rounded-md px-2 text-sm hover:bg-muted lg:min-h-8"
+                  >
+                    {t.name}
+                    <Mono className="text-[11px] text-muted-foreground">{t.products_count}</Mono>
+                  </button>
+                </li>
+              ))}
+            </ul>
+          ) : null}
+        </div>
+      ) : null}
+    </div>
+  );
+}
+
+export function CheckList({
+  items,
+  value,
+  onChange,
+  disabled,
+  empty,
+  renderLabel,
+}: {
+  items: Array<{ id: number; name: string; color?: string }>;
+  value: number[];
+  onChange: (v: number[]) => void;
+  disabled?: boolean;
+  empty: string;
+  renderLabel?: (item: { id: number; name: string; color?: string }) => ReactNode;
+}) {
+  if (items.length === 0) return <p className="text-sm text-muted-foreground">{empty}</p>;
+  return (
+    <ul className="flex flex-col">
+      {items.map((it) => (
+        <li key={it.id}>
+          <label className={cn("flex min-h-11 cursor-pointer items-center gap-2 text-sm lg:min-h-8", disabled && "cursor-default opacity-70")}>
+            <Checkbox
+              checked={value.includes(it.id)}
+              disabled={disabled}
+              onCheckedChange={(on) => onChange(on ? [...value, it.id] : value.filter((x) => x !== it.id))}
+            />
+            {renderLabel ? renderLabel(it) : it.name}
+          </label>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+export function BadgesPicker(props: { value: number[]; onChange: (v: number[]) => void; disabled?: boolean }) {
+  const badges = useBadges().data ?? [];
+  return (
+    <CheckList
+      {...props}
+      items={badges}
+      empty="لا شارات بعد."
+      renderLabel={(b) => (
+        <span className="inline-flex items-center gap-1.5">
+          {/* Badge colour is merchant data (ProductBadge.color), shown as an 8px dot only. */}
+          <span aria-hidden className="size-2 rounded-full border border-border" style={{ backgroundColor: b.color }} />
+          {b.name}
+        </span>
+      )}
+    />
+  );
+}
+
+export function CollectionsPicker(props: { value: number[]; onChange: (v: number[]) => void; disabled?: boolean }) {
+  const collections = useCollections().data ?? [];
+  return <CheckList {...props} items={collections} empty="لا مجموعات بعد." />;
+}
diff --git a/src/features/products/components/editor/variant-matrix.tsx b/src/features/products/components/editor/variant-matrix.tsx
new file mode 100644
index 0000000..1ed2a4c
--- /dev/null
+++ b/src/features/products/components/editor/variant-matrix.tsx
@@ -0,0 +1,416 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import Link from "next/link";
+import { useQueryClient } from "@tanstack/react-query";
+import { toast } from "sonner";
+import { Button } from "@/components/ui/button";
+import { Checkbox } from "@/components/ui/checkbox";
+import { Skeleton } from "@/components/ui/skeleton";
+import { Mono } from "@/components/shared/mono";
+import { Money } from "@/components/shared/money";
+import { isApiError } from "@/lib/api-error";
+import { addDecimal, groupDecimal, isDecimal } from "@/lib/decimal";
+import { formatNumber } from "@/lib/format";
+import { cn } from "@/lib/utils";
+import { useStore } from "@/features/dashboard-shell/components/store-context";
+import {
+  VARIANT_MATRIX_WARN,
+  type ProductDetail,
+  type ProductVariant,
+  type VariantAttribute,
+} from "@/features/products/schemas";
+import { generateVariants, productKeys, saveVariants, useVariantAttributes } from "@/features/products/api/products";
+import { useProductEditorStore, type VariantDraftRow } from "@/stores/product-editor";
+
+/**
+ * Variant generator + matrix (US-04.5, FR-04.09, T073): pick attributes from the store
+ * dictionary and the values that apply → see the combination count (warning past 100) →
+ * exclude combinations → «توليد» → edit SKU / extra price / stock in a table that accepts a
+ * pasted column like a spreadsheet. Unsaved edits live in Zustand; `effective_price` is the
+ * server's, and any value computed from an unsaved edit is labelled «تقديرية» (FR-04.14).
+ * SC-04.4: 12 variants generated and saved in ≤ 3 clicks.
+ */
+const comboKey = (ids: number[]) => [...ids].sort((a, b) => a - b).join(",");
+
+function Swatch({ color, label }: { color: string | null | undefined; label: string }) {
+  if (!color) return null;
+  return (
+    <span
+      aria-hidden
+      title={label}
+      className="inline-block size-3 shrink-0 rounded-sm border border-border"
+      // A merchant-defined swatch is DATA, rendered as data (like OrderStatus.color).
+      style={{ backgroundColor: color }}
+    />
+  );
+}
+
+export function VariantMatrix({ product, readOnly, price }: { product: ProductDetail; readOnly: boolean; price: string }) {
+  const store = useStore();
+  const qc = useQueryClient();
+  const attributes = useVariantAttributes();
+  const drafts = useProductEditorStore((s) => s.variantDrafts[product.id]);
+  const setDraft = useProductEditorStore((s) => s.setVariantDraft);
+  const setDrafts = useProductEditorStore((s) => s.setVariantDrafts);
+
+  const usedOptionIds = useMemo(() => new Set(product.variants.flatMap((v) => v.option_ids)), [product.variants]);
+  const [attrIds, setAttrIds] = useState<number[]>(product.variant_attribute_ids);
+  const [optionIds, setOptionIds] = useState<Set<number> | null>(null);
+  const [excluded, setExcluded] = useState<Set<string>>(new Set());
+  const [busy, setBusy] = useState<"generate" | "save" | null>(null);
+  const [errors, setErrors] = useState<Record<string, string>>({});
+
+  const dict = useMemo(() => attributes.data ?? [], [attributes.data]);
+  const selectedAttrs = dict.filter((a) => attrIds.includes(a.id)).sort((a, b) => a.sort_order - b.sort_order);
+  const effectiveOptions = (a: VariantAttribute) =>
+    a.options.filter((o) => (optionIds ? optionIds.has(o.id) : usedOptionIds.size ? usedOptionIds.has(o.id) : true));
+
+  const combos =
+    selectedAttrs.length === 0
+      ? []
+      : selectedAttrs
+      .map((a) => effectiveOptions(a))
+      .reduce<Array<Array<{ id: number; value: string; color?: string | null }>>>(
+        (acc, opts) => acc.flatMap((c) => opts.map((o) => [...c, { id: o.id, value: o.value, color: o.color }])),
+        [[]],
+      );
+
+  const kept = combos.filter((c) => !excluded.has(comboKey(c.map((o) => o.id))));
+  const optionById = new Map(dict.flatMap((a) => a.options.map((o) => [o.id, o] as const)));
+
+  function toggleAttr(id: number) {
+    setAttrIds((ids) => (ids.includes(id) ? ids.filter((x) => x !== id) : [...ids, id]));
+    setExcluded(new Set());
+  }
+
+  function toggleOption(a: VariantAttribute, id: number) {
+    const base = new Set(optionIds ?? new Set(dict.flatMap((x) => effectiveOptions(x).map((o) => o.id))));
+    if (base.has(id)) base.delete(id);
+    else base.add(id);
+    setOptionIds(base);
+    setExcluded(new Set());
+  }
+
+  function writeVariants(variants: ProductVariant[]) {
+    qc.setQueryData<ProductDetail>(productKeys(store).detail(product.id), (old) =>
+      old ? { ...old, variants, has_variants: variants.length > 0, variant_attribute_ids: attrIds } : old,
+    );
+    void qc.invalidateQueries({ queryKey: [...productKeys(store).all, "list"] });
+  }
+
+  async function generate() {
+    setBusy("generate");
+    try {
+      const allowed = selectedAttrs.flatMap((a) => effectiveOptions(a).map((o) => o.id));
+      const rows = await generateVariants(product.id, {
+        attribute_ids: selectedAttrs.map((a) => a.id),
+        option_ids: allowed,
+        exclude: [...excluded].map((k) => k.split(",").map(Number)),
+      });
+      writeVariants(rows);
+      setDrafts(product.id, undefined);
+      toast.success(rows.length ? `وُلِّد ${rows.length} متغيراً` : "أُزيلت المتغيرات");
+    } catch (err) {
+      toast.error(isApiError(err) ? err.userMessage : "تعذّر التوليد.");
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  function rowOf(v: ProductVariant): VariantDraftRow {
+    return drafts?.[v.id] ?? { sku: v.sku, extra_price: v.extra_price, stock: String(Number(v.stock)) };
+  }
+
+  function edit(v: ProductVariant, field: keyof VariantDraftRow, value: string) {
+    setDraft(product.id, v.id, { ...rowOf(v), [field]: value });
+  }
+
+  /** Paste a multi-line column into a cell → fill downwards (spreadsheet behaviour). */
+  function onPaste(e: React.ClipboardEvent<HTMLInputElement>, startIndex: number, field: keyof VariantDraftRow) {
+    const text = e.clipboardData.getData("text");
+    if (!text.includes("\n")) return;
+    e.preventDefault();
+    const values = text.split(/\r?\n/).map((s) => s.split("\t")[0]!.trim()).filter((s, i, a) => s !== "" || i < a.length - 1);
+    values.forEach((val, i) => {
+      const v = product.variants[startIndex + i];
+      if (v) edit(v, field, val);
+    });
+    toast(`لُصقت ${Math.min(values.length, product.variants.length - startIndex)} قيم`);
+  }
+
+  const dirtyIds = Object.keys(drafts ?? {}).map(Number);
+
+  async function save() {
+    const rows = product.variants
+      .filter((v) => dirtyIds.includes(v.id))
+      .map((v) => ({ id: v.id, ...rowOf(v) }));
+    const errs: Record<string, string> = {};
+    for (const r of rows) {
+      if (!isDecimal(r.extra_price)) errs[`${r.id}.extra_price`] = "رقم غير صالح";
+      if (!/^\d+(\.\d{1,3})?$/.test(r.stock)) errs[`${r.id}.stock`] = "رقم غير صالح";
+      if (!r.sku.trim()) errs[`${r.id}.sku`] = "مطلوب";
+    }
+    setErrors(errs);
+    if (Object.keys(errs).length) return;
+    setBusy("save");
+    try {
+      writeVariants(await saveVariants(product.id, rows));
+      setDrafts(product.id, undefined);
+      toast.success("حُفظت المتغيرات");
+    } catch (err) {
+      if (isApiError(err) && err.fields) {
+        const mapped: Record<string, string> = {};
+        for (const [k, v] of Object.entries(err.fields)) mapped[k.replace(/^variants\./, "")] = v[0] ?? "";
+        setErrors(mapped);
+      }
+      toast.error(isApiError(err) ? err.userMessage : "تعذّر الحفظ.");
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  if (attributes.isLoading) return <Skeleton className="h-32 w-full" />;
+
+  return (
+    <div className="flex flex-col gap-5" data-testid="variant-matrix">
+      {!readOnly ? (
+        <div className="flex flex-col gap-4">
+          <div className="flex flex-col gap-2">
+            <p className="text-sm font-medium">السمات</p>
+            {dict.length === 0 ? (
+              <p className="text-sm text-muted-foreground">
+                لا سمات في قاموس المتجر بعد.{" "}
+                <Link href="/dashboard/products/variants" className="underline underline-offset-4">
+                  أضف سمة
