@@ -0,0 +1,211 @@
+import { toWesternDigits } from "@/lib/format";
+import type { ProductDetail, ProductFormValues } from "@/features/products/schemas";
+
+/**
+ * ProductDetail (API) ⇄ ProductFormValues (RHF). Inputs are text; the payload sends decimal
+ * TEXT for money/quantities (data-model §6), integers for counts, `null` for empty
+ * optionals — never a float.
+ */
+const s = (v: string | number | null | undefined) => (v === null || v === undefined ? "" : String(v));
+
+/** `2026-10-20T09:00:00.000Z` → `2026-10-20T12:00` in the browser's zone (datetime-local). */
+export function isoToLocalInput(iso: string | null): string {
+  if (!iso) return "";
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return "";
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function localInputToIso(v: string): string | null {
+  if (!v) return null;
+  const d = new Date(v);
+  return Number.isNaN(d.getTime()) ? null : d.toISOString();
+}
+
+export const EMPTY_PRODUCT_FORM: ProductFormValues = {
+  name: "",
+  name_en: "",
+  slug: "",
+  sku: "",
+  barcode: "",
+  product_type: "physical",
+  category_id: "",
+  brand_id: "",
+  tag_ids: [],
+  badge_ids: [],
+  collection_ids: [],
+  price: "",
+  old_price: "",
+  sale_start_at: "",
+  sale_end_at: "",
+  cost_price: "",
+  currency: "SAR",
+  payment_policy: "cod",
+  deposit_required: "",
+  is_taxable: false,
+  tax_rate: "",
+  pricing_type: "fixed",
+  live_rate_ref: "",
+  formula_unit_price: "",
+  formula_coefficient: "",
+  formula_fixed_extra: "",
+  has_refundable_deposit: false,
+  refundable_deposit_amount: "",
+  refundable_deposit_refund_rule: "",
+  refundable_deposit_return_event: "",
+  is_serialized: false,
+  is_bundle: false,
+  bundle_build_fee: "",
+  is_auction: false,
+  is_personalizable: false,
+  is_bookable: false,
+  booking_duration_minutes: "",
+  stock: "0",
+  unit: "piece",
+  low_stock_threshold: "",
+  allow_backorder: false,
+  min_quantity: "",
+  max_quantity: "",
+  allow_variable_quantity: false,
+  description: "",
+  description_en: "",
+  image_url: "",
+  video_url: "",
+  variant_display_style: "dropdown",
+  product_template: "standard",
+  is_available: true,
+  published_at: "",
+  is_featured: false,
+  is_free_shipping: false,
+  delivery_duration: "",
+  weight: "",
+  length: "",
+  width: "",
+  height: "",
+  is_hazardous: false,
+  hazard_class: "none",
+  meta_title: "",
+  meta_description: "",
+  meta_keywords: "",
+};
+
+export function detailToForm(p: ProductDetail): ProductFormValues {
+  return {
+    name: p.name,
+    name_en: p.name_en,
+    slug: p.slug,
+    sku: p.sku,
+    barcode: p.barcode,
+    product_type: p.product_type,
+    category_id: s(p.category_id),
+    brand_id: s(p.brand_id),
+    tag_ids: p.tag_ids,
+    badge_ids: p.badge_ids,
+    collection_ids: p.collection_ids,
+    price: p.price,
+    old_price: s(p.old_price),
+    sale_start_at: isoToLocalInput(p.sale_start_at),
+    sale_end_at: isoToLocalInput(p.sale_end_at),
+    cost_price: s(p.cost_price),
+    currency: p.currency,
+    payment_policy: p.payment_policy,
+    deposit_required: s(p.deposit_required),
+    is_taxable: p.is_taxable,
+    tax_rate: s(p.tax_rate),
+    pricing_type: p.pricing_type,
+    live_rate_ref: s(p.live_rate_ref),
+    formula_unit_price: s(p.formula_unit_price),
+    formula_coefficient: s(p.formula_coefficient),
+    formula_fixed_extra: s(p.formula_fixed_extra),
+    has_refundable_deposit: p.has_refundable_deposit,
+    refundable_deposit_amount: s(p.refundable_deposit_amount),
+    refundable_deposit_refund_rule: p.refundable_deposit_refund_rule,
+    refundable_deposit_return_event: p.refundable_deposit_return_event,
+    is_serialized: p.is_serialized,
+    is_bundle: p.is_bundle,
+    bundle_build_fee: s(p.bundle_build_fee),
+    is_auction: p.is_auction,
+    is_personalizable: p.is_personalizable,
+    is_bookable: p.is_bookable,
+    booking_duration_minutes: s(p.booking_duration_minutes),
+    stock: String(Number(p.stock)),
+    unit: p.unit,
+    low_stock_threshold: s(p.low_stock_threshold),
+    allow_backorder: p.allow_backorder,
+    min_quantity: s(p.min_quantity),
+    max_quantity: s(p.max_quantity),
+    allow_variable_quantity: p.allow_variable_quantity,
+    description: p.description,
+    description_en: p.description_en,
+    image_url: p.image_url,
+    video_url: p.video_url,
+    variant_display_style: p.variant_display_style,
+    product_template: p.product_template,
+    is_available: p.is_available,
+    published_at: isoToLocalInput(p.published_at),
+    is_featured: p.is_featured,
+    is_free_shipping: p.is_free_shipping,
+    delivery_duration: p.delivery_duration,
+    weight: s(p.weight),
+    length: s(p.length),
+    width: s(p.width),
+    height: s(p.height),
+    is_hazardous: p.is_hazardous,
+    hazard_class: p.hazard_class,
+    meta_title: p.meta_title,
+    meta_description: p.meta_description,
+    meta_keywords: p.meta_keywords,
+  };
+}
+
+const DECIMAL_FIELDS = [
+  "price",
+  "old_price",
+  "cost_price",
+  "deposit_required",
+  "tax_rate",
+  "formula_unit_price",
+  "formula_coefficient",
+  "formula_fixed_extra",
+  "refundable_deposit_amount",
+  "bundle_build_fee",
+  "stock",
+  "weight",
+  "length",
+  "width",
+  "height",
+] as const;
+
+const INT_FIELDS = ["booking_duration_minutes", "low_stock_threshold", "min_quantity", "max_quantity", "category_id", "brand_id"] as const;
+
+export function formToPayload(v: ProductFormValues): Record<string, unknown> {
+  const out: Record<string, unknown> = { ...v };
+  for (const k of DECIMAL_FIELDS) {
+    const raw = toWesternDigits(v[k]).trim();
+    out[k] = raw === "" ? null : raw;
+  }
+  for (const k of INT_FIELDS) {
+    const raw = toWesternDigits(v[k]).trim();
+    out[k] = raw === "" ? null : Number.parseInt(raw, 10);
+  }
+  out.sale_start_at = localInputToIso(v.sale_start_at);
+  out.sale_end_at = localInputToIso(v.sale_end_at);
+  out.published_at = localInputToIso(v.published_at);
+  out.live_rate_ref = v.live_rate_ref || null;
+  // Conditional fields that are hidden are also not sent (FR-04.04).
+  if (v.payment_policy !== "deposit") out.deposit_required = null;
+  if (!v.is_taxable) out.tax_rate = null;
+  if (v.pricing_type !== "formula") {
+    out.formula_unit_price = null;
+    out.formula_coefficient = null;
+    out.formula_fixed_extra = null;
+    out.live_rate_ref = null;
+  }
+  if (!v.has_refundable_deposit) out.refundable_deposit_amount = null;
+  if (!v.is_bundle) out.bundle_build_fee = null;
+  if (!v.is_bookable) out.booking_duration_minutes = null;
+  if (!v.is_hazardous) out.hazard_class = "none";
+  if (out.stock === null) out.stock = "0";
+  return out;
+}
diff --git a/src/features/products/components/editor/media-gallery.tsx b/src/features/products/components/editor/media-gallery.tsx
new file mode 100644
index 0000000..7af793e
--- /dev/null
+++ b/src/features/products/components/editor/media-gallery.tsx
@@ -0,0 +1,227 @@
+"use client";
+
+import { useRef, useState } from "react";
+import Image from "next/image";
+import { DndContext, KeyboardSensor, PointerSensor, closestCenter, useSensor, useSensors, type DragEndEvent } from "@dnd-kit/core";
+import { SortableContext, arrayMove, rectSortingStrategy, sortableKeyboardCoordinates, useSortable } from "@dnd-kit/sortable";
+import { transformToString } from "@/lib/dnd";
+import { GripVertical, ImagePlus, Link2, Trash2, Video } from "lucide-react";
+import { toast } from "sonner";
+import { useQueryClient } from "@tanstack/react-query";
+import { Mono } from "@/components/shared/mono";
+import { isApiError } from "@/lib/api-error";
+import { useStore } from "@/features/dashboard-shell/components/store-context";
+import { hasImageExtension, IMAGE_EXTENSIONS_MESSAGE } from "@/features/organization/schemas";
+import type { ProductDetail, ProductImage } from "@/features/products/schemas";
+import { deleteImage, productKeys, reorderImages, uploadImages } from "@/features/products/api/products";
+import { useProductEditorStore } from "@/stores/product-editor";
+import { cn } from "@/lib/utils";
+
+/**
+ * Media gallery (US-04.4, FR-04.08): drag to reorder with @dnd-kit (the first image is the
+ * main one, `sort_order` saved immediately), multi-upload with a local extension check, and
+ * delete with a 5-second undo before the request is sent. The external `image_url` and
+ * `video_url` appear as items tagged «رابط». Drag handles sit at the START side (II).
+ */
+const ANNOUNCE = {
+  onDragStart: () => "بدأ سحب الصورة.",
+  onDragOver: () => "",
+  onDragEnd: ({ over }: { over: { id: string | number } | null }) => (over ? "أُفلتت الصورة في موضعها الجديد." : "أُلغي السحب."),
+  onDragCancel: () => "أُلغي السحب.",
+};
+
+function SortableImage({
+  image,
+  index,
+  onDelete,
+  disabled,
+}: {
+  image: ProductImage;
+  index: number;
+  onDelete: () => void;
+  disabled: boolean;
+}) {
+  const { attributes, listeners, setNodeRef, setActivatorNodeRef, transform, transition, isDragging } = useSortable({ id: image.id, disabled });
+  return (
+    <li
+      ref={setNodeRef}
+      style={{ transform: transformToString(transform), transition }}
+      className={cn("group relative aspect-square overflow-hidden rounded-lg border border-border bg-muted", isDragging && "z-10 ring-1 ring-foreground")}
+      data-testid="gallery-item"
+    >
+      <Image src={image.url} alt={`صورة ${index + 1}`} fill sizes="160px" unoptimized className="object-cover" />
+      {index === 0 ? (
+        <span className="absolute top-1.5 end-1.5 rounded-sm border border-border bg-background px-1.5 text-[11px]">الرئيسية</span>
+      ) : null}
+      {!disabled ? (
+        <>
+          <button
+            type="button"
+            ref={setActivatorNodeRef}
+            {...attributes}
+            {...listeners}
+            aria-label={`اسحب لإعادة ترتيب الصورة ${index + 1}`}
+            className="absolute top-1.5 start-1.5 flex size-11 cursor-grab items-center justify-center rounded-md border border-border bg-background/90 lg:size-7"
+          >
+            <GripVertical className="size-4" aria-hidden />
+          </button>
+          <button
+            type="button"
+            onClick={onDelete}
+            aria-label={`حذف الصورة ${index + 1}`}
+            className="absolute bottom-1.5 start-1.5 flex size-11 items-center justify-center rounded-md border border-border bg-background/90 text-destructive lg:size-7"
+          >
+            <Trash2 className="size-4" aria-hidden />
+          </button>
+        </>
+      ) : null}
+    </li>
+  );
+}
+
+export function MediaGallery({ product, readOnly }: { product: ProductDetail; readOnly: boolean }) {
+  const store = useStore();
+  const qc = useQueryClient();
+  const inputRef = useRef<HTMLInputElement>(null);
+  const [error, setError] = useState("");
+  const [uploading, setUploading] = useState(false);
+  const [hidden, setHidden] = useState<number[]>([]);
+  const order = useProductEditorStore((s) => s.galleryOrder[product.id]);
+  const setOrder = useProductEditorStore((s) => s.setGalleryOrder);
+  const sensors = useSensors(
+    useSensor(PointerSensor, { activationConstraint: { distance: 4 } }),
+    useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates }),
+  );
+
+  const byId = new Map(product.images.map((i) => [i.id, i]));
+  const ordered = (order ?? product.images.map((i) => i.id))
+    .map((id) => byId.get(id))
+    .filter((i): i is ProductImage => Boolean(i) && !hidden.includes(i!.id));
+
+  const writeImages = (images: ProductImage[]) =>
+    qc.setQueryData<ProductDetail>(productKeys(store).detail(product.id), (old) => (old ? { ...old, images } : old));
+
+  async function onFiles(files: FileList | null) {
+    setError("");
+    const list = Array.from(files ?? []);
+    if (list.length === 0) return;
+    const bad = list.find((f) => !hasImageExtension(f.name));
+    if (bad) {
+      setError(IMAGE_EXTENSIONS_MESSAGE);
+      return;
+    }
+    setUploading(true);
+    try {
+      writeImages(await uploadImages(product.id, list));
+      setOrder(product.id, undefined);
+      toast.success(list.length === 1 ? "رُفعت الصورة" : `رُفعت ${list.length} صور`);
+    } catch (err) {
+      setError(isApiError(err) ? err.userMessage : "تعذّر رفع الصور.");
+    } finally {
+      setUploading(false);
+      if (inputRef.current) inputRef.current.value = "";
+    }
+  }
+
+  async function onDragEnd(event: DragEndEvent) {
+    const { active, over } = event;
+    if (!over || active.id === over.id) return;
+    const ids = ordered.map((i) => i.id);
+    const next = arrayMove(ids, ids.indexOf(Number(active.id)), ids.indexOf(Number(over.id)));
+    setOrder(product.id, next);
+    try {
+      writeImages(await reorderImages(product.id, next));
+      setOrder(product.id, undefined);
+    } catch {
+      setOrder(product.id, undefined);
+      toast.error("تعذّر حفظ الترتيب؛ أُعيد الترتيب السابق.");
+    }
+  }
+
+  function onDelete(imageId: number) {
+    setHidden((h) => [...h, imageId]);
+    let undone = false;
+    toast("حُذفت الصورة", {
+      duration: 5000,
+      action: {
+        label: "تراجع",
+        onClick: () => {
+          undone = true;
+          setHidden((h) => h.filter((x) => x !== imageId));
+        },
+      },
+    });
+    window.setTimeout(async () => {
+      if (undone) return;
+      try {
+        writeImages(await deleteImage(product.id, imageId));
+      } catch {
+        toast.error("تعذّر حذف الصورة.");
+      } finally {
+        setHidden((h) => h.filter((x) => x !== imageId));
+      }
+    }, 5000);
+  }
+
+  return (
+    <div className="flex flex-col gap-3">
+      <DndContext sensors={sensors} collisionDetection={closestCenter} onDragEnd={(e) => void onDragEnd(e)} accessibility={{ announcements: ANNOUNCE }}>
+        <SortableContext items={ordered.map((i) => i.id)} strategy={rectSortingStrategy}>
+          <ul className="grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-5">
+            {ordered.map((img, i) => (
+              <SortableImage key={img.id} image={img} index={i} disabled={readOnly} onDelete={() => onDelete(img.id)} />
+            ))}
+            {!readOnly ? (
+              <li>
+                <button
+                  type="button"
+                  onClick={() => inputRef.current?.click()}
+                  disabled={uploading}
+                  className="flex aspect-square w-full flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-border text-xs text-muted-foreground hover:bg-muted"
+                >
+                  <ImagePlus className="size-5" strokeWidth={1.5} aria-hidden />
+                  {uploading ? "جارٍ الرفع…" : "إضافة صور"}
+                </button>
+              </li>
+            ) : null}
+          </ul>
+        </SortableContext>
+      </DndContext>
+      <input
+        ref={inputRef}
+        type="file"
+        multiple
+        accept=".jpg,.jpeg,.png,.webp,.gif"
+        className="sr-only"
+        aria-label="رفع صور المنتج"
