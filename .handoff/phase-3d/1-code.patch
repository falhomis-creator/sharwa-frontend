+                          ))}
+                          {v.label}
+                        </span>
+                      </td>
+                      {(["sku", "extra_price", "stock"] as const).map((field) => (
+                        <td key={field} className="px-3 py-1">
+                          <input
+                            dir="ltr"
+                            value={row[field]}
+                            readOnly={readOnly}
