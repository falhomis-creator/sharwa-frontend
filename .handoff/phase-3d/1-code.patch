+  sku: z.string().optional(),
+  extra_price: z.string().optional(),
+  stock: z.string().optional(),
+});
diff --git a/src/lib/bff/mock-route.ts b/src/lib/bff/mock-route.ts
new file mode 100644
index 0000000..93058a6
--- /dev/null
+++ b/src/lib/bff/mock-route.ts
@@ -0,0 +1,71 @@
+import "server-only";
+import { contextFromRequest, jsonResponse } from "@/lib/bff/upstream";
+import { sessionFromRequest, storeHostFor } from "@/features/dashboard-shell/api/session";
+import type { Session } from "@/features/dashboard-shell/schemas";
+import { hasPermission, type PermissionKey } from "@/lib/access";
+import { isMocksOn, mockJson, notAvailable, type MockInit } from "@/mocks/runtime";
+
+/**
+ * Shared skeleton of the dashboard `[NEEDS BACKEND]` adapters (M04/M05/M06/M48/M49), in
+ * the same `mock` mode the M03 adapters use (bff README): the session gate first (401),
+ * then the optional permission gate (403, the server half of FR-04.16 / FR-06.11), then
+ * the fixture. With `SHARWA_MOCKS=off` every row answers 501 «غير متاح بعد».
+ *
+ * The day Django ships the `/api/v1/<resource>` row, the handler body becomes a
+ * passthrough and the UI does not change.
+ */
+export interface MockRouteContext {
+  store: string | null;
+  storeHost: string;
+  session: Session;
+  url: URL;
+}
+
+export async function mockRoute(
+  request: Request,
+  handler: (ctx: MockRouteContext) => Promise<Response> | Response,
+  opts: { permission?: PermissionKey } = {},
+): Promise<Response> {
+  const upstream = contextFromRequest(request);
+  const storeHost = storeHostFor(upstream.store, upstream.storeHost);
+  const session = await sessionFromRequest(request, { store: upstream.store, storeHost });
+  if (!session) return jsonResponse({ detail: "انتهت جلستك، سجّل الدخول مجدداً." }, { status: 401 });
+  if (!isMocksOn()) return notAvailable();
+  if (
+    opts.permission &&
+    !hasPermission({ kind: session.kind, features: session.features, permissions: session.staff?.permissions }, opts.permission)
+  ) {
+    return mockJson({ detail: "ليست لديك صلاحية لهذا الإجراء." }, { status: 403 });
+  }
+  return handler({ store: upstream.store, storeHost, session, url: new URL(request.url) });
+}
+
+/** A mock result → response: `{ok:true,data}` → 200 (or `status`), `{ok:false}` → DRF error body. */
+export type MockResult<T> =
+  | { ok: true; data: T; status?: number }
+  | { ok: false; status: number; body: Record<string, unknown> };
+
+export function respond<T>(result: MockResult<T>, init: MockInit = {}): Promise<Response> {
+  if (result.ok) return mockJson(result.data, { delay: 180, status: result.status, ...init });
+  return mockJson(result.body, { status: result.status, delay: 120 });
+}
+
+export async function readBody(request: Request): Promise<Record<string, unknown>> {
+  try {
+    const data: unknown = await request.json();
+    return data && typeof data === "object" && !Array.isArray(data) ? (data as Record<string, unknown>) : {};
+  } catch {
+    return {};
+  }
+}
+
+/** The system roles that may create/edit catalogue entities (M04 §2, M05 §2 assumption). */
+export function canManageCatalog(session: Session): boolean {
+  if (session.kind === "merchant") return true;
+  const roles = session.staff?.roles ?? [];
+  return roles.some((r) => r === "مدير المتجر" || r === "مدير الفرع");
+}
+
+export function forbidden(): Promise<Response> {
+  return mockJson({ detail: "إنشاء المنتجات وتعديلها مقصور على المالك ومدير المتجر أو الفرع." }, { status: 403 });
+}
diff --git a/src/lib/decimal.ts b/src/lib/decimal.ts
new file mode 100644
index 0000000..8962b87
--- /dev/null
+++ b/src/lib/decimal.ts
@@ -0,0 +1,69 @@
+/**
+ * Decimal-as-text helpers for INPUTS and ESTIMATES only (data-model §6: amounts are
+ * decimal strings, never floats). Display money still comes from the server (`display_*`);
+ * anything computed here is labelled «تقديرية» where it is shown (M04 FR-04.14).
+ *
+ * Fixed-point on BigInt with 6 fractional digits — enough for prices, coefficients and
+ * Decimal(12,3) stock without float drift.
+ */
+const SCALE = 6;
+const FACTOR = BigInt(10 ** SCALE);
+const ZERO = BigInt(0);
+const TWO = BigInt(2);
+const HUNDRED = BigInt(100);
+const DECIMAL_RE = /^-?\d+(\.\d+)?$/;
+
+export function isDecimal(value: string | null | undefined): value is string {
+  return typeof value === "string" && DECIMAL_RE.test(value.trim());
+}
+
+function toUnits(value: string): bigint {
+  const v = value.trim();
+  const negative = v.startsWith("-");
+  const [int = "0", frac = ""] = (negative ? v.slice(1) : v).split(".");
+  const units = BigInt(int) * FACTOR + BigInt((frac + "0".repeat(SCALE)).slice(0, SCALE));
+  return negative ? -units : units;
+}
+
+function fromUnits(units: bigint, places: number): string {
+  const negative = units < ZERO;
+  let abs = negative ? -units : units;
+  // round half up to `places`
+  const drop = BigInt(10 ** (SCALE - places));
+  abs = ((abs + drop / TWO) / drop) * drop;
+  const int = abs / FACTOR;
+  const frac = (abs % FACTOR).toString().padStart(SCALE, "0").slice(0, places);
+  return `${negative ? "-" : ""}${int}${places > 0 ? `.${frac}` : ""}`;
+}
+
+export function addDecimal(a: string, b: string, places = 2): string {
+  return fromUnits(toUnits(a) + toUnits(b), places);
+}
+
+export function subDecimal(a: string, b: string, places = 2): string {
+  return fromUnits(toUnits(a) - toUnits(b), places);
+}
+
+export function mulDecimal(a: string, b: string, places = 2): string {
+  return fromUnits((toUnits(a) * toUnits(b)) / FACTOR, places);
+}
+
+/** -1 / 0 / 1 */
+export function compareDecimal(a: string, b: string): number {
+  const d = toUnits(a) - toUnits(b);
+  return d === ZERO ? 0 : d < ZERO ? -1 : 1;
+}
+
+/** `amount * percent / 100` */
+export function percentOf(amount: string, percent: string, places = 2): string {
+  return fromUnits((toUnits(amount) * toUnits(percent)) / (FACTOR * HUNDRED), places);
+}
+
+/** Thousands separators for an estimate (western digits); never used for server money. */
+export function groupDecimal(value: string): string {
+  const [int = "0", frac] = value.split(".");
+  const sign = int.startsWith("-") ? "-" : "";
+  const digits = sign ? int.slice(1) : int;
+  const grouped = digits.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+  return `${sign}${grouped}${frac !== undefined ? `.${frac}` : ""}`;
+}
diff --git a/src/lib/dnd.ts b/src/lib/dnd.ts
new file mode 100644
index 0000000..7260ad1
--- /dev/null
+++ b/src/lib/dnd.ts
@@ -0,0 +1,22 @@
+
+/**
+ * `CSS.Transform.toString` without importing `@dnd-kit/utilities` directly (it is only a
+ * transitive dependency of @dnd-kit/sortable, not one of ours).
+ */
+export interface Transform {
+  x: number;
+  y: number;
+  scaleX: number;
+  scaleY: number;
+}
+
+export function transformToString(t: Transform | null): string | undefined {
+  if (!t) return undefined;
+  return `translate3d(${Math.round(t.x)}px, ${Math.round(t.y)}px, 0) scaleX(${t.scaleX}) scaleY(${t.scaleY})`;
+}
+
+/** Translate only — for vertical lists where scaling would distort text. */
+export function translateToString(t: Transform | null): string | undefined {
+  if (!t) return undefined;
+  return `translate3d(${Math.round(t.x)}px, ${Math.round(t.y)}px, 0)`;
+}
diff --git a/src/lib/i18n/normalize.ts b/src/lib/i18n/normalize.ts
new file mode 100644
index 0000000..3c2489f
--- /dev/null
+++ b/src/lib/i18n/normalize.ts
@@ -0,0 +1,93 @@
+/**
+ * Arabic search normalization (M48 FR-48.05) — one implementation shared by the command
+ * palette and every list search box (M04, M05, M06), so «الكترونيات» finds «إلكترونيات»
+ * everywhere or nowhere.
+ *
+ * Rules (M48 US-48.5.2): أ/إ/آ/ٱ → ا · ة → ه · ى → ي · ؤ → و · ئ → ي · tashkeel and tatweel
+ * removed · Arabic-Indic and Persian digits → western · lowercase · whitespace collapsed.
+ */
+const TASHKEEL = /[ؐ-ًؚ-ٰٟۖ-ۭ]/g;
+const TATWEEL = /ـ/g;
+
+export function normalizeArabic(input: string): string {
+  return input
+    .replace(TASHKEEL, "")
+    .replace(TATWEEL, "")
+    .replace(/[أإآٱ]/g, "ا")
+    .replace(/ة/g, "ه")
+    .replace(/ى/g, "ي")
+    .replace(/ؤ/g, "و")
+    .replace(/ئ/g, "ي")
+    .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
+    .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
+    .toLowerCase()
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** Strip the Arabic definite article from a single token («الطلبات» → «طلبات»). */
+function stripArticle(token: string): string {
+  return token.length > 3 && token.startsWith("ال") ? token.slice(2) : token;
+}
+
+/** Levenshtein distance capped at `max` (early exit) — small strings only. */
+function boundedDistance(a: string, b: string, max: number): number {
+  if (Math.abs(a.length - b.length) > max) return max + 1;
+  let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 1; i <= a.length; i++) {
+    const cur = [i];
+    let rowMin = i;
+    for (let j = 1; j <= b.length; j++) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      const v = Math.min(prev[j]! + 1, cur[j - 1]! + 1, prev[j - 1]! + cost);
+      cur.push(v);
+      if (v < rowMin) rowMin = v;
+    }
+    if (rowMin > max) return max + 1;
+    prev = cur;
+  }
+  return prev[b.length]!;
+}
+
+/**
+ * Score a query against a list of haystack strings (title + keywords), higher is better,
+ * 0 = no match. Order of preference (FR-48.05): word start > substring > fuzzy.
+ */
+export function matchScore(query: string, haystacks: readonly string[]): number {
+  const q = normalizeArabic(query);
+  if (!q) return 0;
+  const qTokens = q.split(" ").map(stripArticle);
+  let best = 0;
+  for (const raw of haystacks) {
+    const h = normalizeArabic(raw);
+    if (!h) continue;
+    if (h === q) return 100;
+    const words = h.split(" ").map(stripArticle);
+    let score = 0;
+    let all = true;
+    for (const t of qTokens) {
+      if (!t) continue;
+      if (words.some((w) => w.startsWith(t))) score += 30;
+      else if (h.includes(t)) score += 18;
+      else {
+        const tolerance = t.length >= 6 ? 2 : t.length >= 4 ? 1 : 0;
+        if (tolerance > 0 && words.some((w) => boundedDistance(w.slice(0, t.length + 1), t, tolerance) <= tolerance)) {
+          score += 8;
+        } else {
+          all = false;
+          break;
+        }
+      }
+    }
+    if (all && score > best) best = score;
+  }
+  return best;
+}
+
+/** `true` when every token of the query is found in the text after normalization. */
+export function includesNormalized(text: string, query: string): boolean {
+  const q = normalizeArabic(query);
+  if (!q) return true;
+  const h = normalizeArabic(text);
+  return q.split(" ").every((t) => h.includes(t));
+}
diff --git a/src/mocks/catalog/dictionary.ts b/src/mocks/catalog/dictionary.ts
new file mode 100644
index 0000000..8185c97
--- /dev/null
+++ b/src/mocks/catalog/dictionary.ts
@@ -0,0 +1,315 @@
+import type { MockResult } from "@/lib/bff/mock-route";
+import { DATA_TYPES, FIELD_TYPES, type VariantAttribute, type VariantOption } from "@/features/products/schemas";
+import type { ApplyTemplateResult, ProductTemplate } from "@/features/products/schemas";
+import { globalTemplates } from "@/mocks/catalog/seed";
+import { applyTemplateFields } from "@/mocks/catalog/products";
+import { catalog, nextCatalogId } from "@/mocks/catalog/state";
+import { FIXTURE_NOW } from "@/mocks/store-state";
+
+/**
+ * Variant dictionary (`variant_hub`) and blueprints (`ProductTemplate`) — M04 §7 rows,
+ * all `[NEEDS BACKEND]`. Deleting an attribute used by variants is refused with the count
+ * of affected products (M04 §8). Applying a central sector copies its attributes into the
+ * store dictionary without duplicating the existing ones (US-04.6.1).
+ */
+type Body = Record<string, unknown>;
+const str = (v: unknown) => (typeof v === "string" ? v : v === null || v === undefined ? "" : String(v));
+const now = () => new Date(Math.max(Date.now(), FIXTURE_NOW)).toISOString();
+
+function productsUsing(store: string | null, attributeId: number): number {
+  const state = catalog(store);
+  const optionIds = new Set(state.attributes.find((a) => a.id === attributeId)?.options.map((o) => o.id) ?? []);
+  const products = new Set<number>();
+  for (const v of state.variants) if (v.option_ids.some((o) => optionIds.has(o))) products.add(v.product_id);
+  return products.size;
+}
+
+export function listAttributes(store: string | null): VariantAttribute[] {
+  const state = catalog(store);
+  return [...state.attributes]
+    .sort((a, b) => a.sort_order - b.sort_order)
+    .map((a) => ({ ...a, products_count: productsUsing(store, a.id) }));
+}
+
+function validateAttribute(body: Body): Record<string, string[]> {
+  const e: Record<string, string[]> = {};
+  if (!str(body.name).trim()) e.name = ["أدخل اسم السمة."];
+  if (!(FIELD_TYPES as readonly string[]).includes(str(body.field_type))) e.field_type = ["اختر نوع الحقل."];
+  if (!(DATA_TYPES as readonly string[]).includes(str(body.data_type))) e.data_type = ["اختر نوع البيانات."];
+  if (body.data_type === "unit" && !str(body.unit).trim()) e.unit = ["أدخل الوحدة (مثال: سم، غ)."];
+  return e;
+}
+
+export function createAttribute(store: string | null, body: Body): MockResult<VariantAttribute> {
+  const errors = validateAttribute(body);
+  const state = catalog(store);
+  if (state.attributes.some((a) => a.name === str(body.name).trim())) errors.name = ["سمة بهذا الاسم موجودة."];
+  if (Object.keys(errors).length) return { ok: false, status: 400, body: errors };
+  const attr = {
+    id: nextCatalogId(state, "attribute"),
+    name: str(body.name).trim(),
+    field_type: str(body.field_type) as VariantAttribute["field_type"],
+    data_type: str(body.data_type) as VariantAttribute["data_type"],
+    unit: str(body.unit),
+    min_value: str(body.min_value) || null,
+    max_value: str(body.max_value) || null,
+    is_required: Boolean(body.is_required),
+    sort_order: Number(str(body.sort_order) || state.attributes.length),
+    options: [] as VariantOption[],
+  };
+  state.attributes.push(attr);
+  return { ok: true, status: 201, data: { ...attr, products_count: 0 } };
+}
+
+export function updateAttribute(store: string | null, id: number, body: Body): MockResult<VariantAttribute> {
+  const state = catalog(store);
+  const attr = state.attributes.find((a) => a.id === id);
+  if (!attr) return { ok: false, status: 404, body: { detail: "السمة غير موجودة." } };
+  const errors = validateAttribute({ ...attr, ...body });
+  if (Object.keys(errors).length) return { ok: false, status: 400, body: errors };
+  if ("name" in body) attr.name = str(body.name).trim();
+  if ("field_type" in body) attr.field_type = str(body.field_type) as VariantAttribute["field_type"];
+  if ("data_type" in body) attr.data_type = str(body.data_type) as VariantAttribute["data_type"];
+  if ("unit" in body) attr.unit = str(body.unit);
+  if ("min_value" in body) attr.min_value = str(body.min_value) || null;
+  if ("max_value" in body) attr.max_value = str(body.max_value) || null;
+  if ("is_required" in body) attr.is_required = Boolean(body.is_required);
+  if ("sort_order" in body) attr.sort_order = Number(str(body.sort_order) || 0);
+  return { ok: true, data: { ...attr, products_count: productsUsing(store, id) } };
+}
+
+export function deleteAttribute(store: string | null, id: number): MockResult<null> {
+  const state = catalog(store);
+  const used = productsUsing(store, id);
+  if (used > 0) {
+    return {
+      ok: false,
+      status: 409,
+      body: { detail: `لا يمكن حذف السمة: مستخدمة في متغيرات ${used} ${used === 1 ? "منتج" : "منتجات"}.`, products_count: used },
+    };
+  }
+  state.attributes = state.attributes.filter((a) => a.id !== id);
+  return { ok: true, status: 204, data: null };
+}
+
+function optionValueErrors(attr: { data_type: string; min_value: string | null; max_value: string | null }, value: string) {
+  if (!value.trim()) return ["أدخل القيمة."];
+  if (attr.data_type === "number" || attr.data_type === "unit") {
+    if (!/^-?\d+(\.\d+)?$/.test(value)) return ["القيمة رقم."];
+    const n = Number(value);
+    if (attr.min_value !== null && n < Number(attr.min_value)) return [`أقل قيمة مسموحة ${attr.min_value}.`];
+    if (attr.max_value !== null && n > Number(attr.max_value)) return [`أعلى قيمة مسموحة ${attr.max_value}.`];
+  }
+  if (attr.data_type === "date" && !/^\d{4}-\d{2}-\d{2}$/.test(value)) return ["تاريخ بصيغة YYYY-MM-DD."];
+  return null;
+}
+
+export function createOption(store: string | null, attributeId: number, body: Body): MockResult<VariantOption> {
+  const state = catalog(store);
+  const attr = state.attributes.find((a) => a.id === attributeId);
+  if (!attr) return { ok: false, status: 404, body: { detail: "السمة غير موجودة." } };
+  const value = str(body.value).trim();
+  const err = optionValueErrors(attr, value);
+  if (err) return { ok: false, status: 400, body: { value: err } };
+  if (attr.options.some((o) => o.value === value)) return { ok: false, status: 400, body: { value: ["القيمة موجودة."] } };
+  const typed = attr.data_type === "number" || attr.data_type === "unit";
+  const opt: VariantOption = {
+    id: nextCatalogId(state, "option"),
+    attribute_id: attributeId,
+    value,
+    text_value: typed ? null : value,
+    numeric_value: attr.data_type === "number" ? value : null,
+    unit_value: attr.data_type === "unit" ? value : null,
+    boolean_value: attr.data_type === "bool" ? value === "نعم" : null,
+    date_value: attr.data_type === "date" ? value : null,
+    image: typeof body.image === "string" && body.image ? body.image : null,
+    color: typeof body.color === "string" && /^#[0-9a-fA-F]{6}$/.test(body.color) ? body.color : null,
+  };
+  attr.options.push(opt);
+  return { ok: true, status: 201, data: opt };
+}
+
+export function updateOption(store: string | null, optionId: number, body: Body): MockResult<VariantOption> {
+  const state = catalog(store);
+  const attr = state.attributes.find((a) => a.options.some((o) => o.id === optionId));
+  const opt = attr?.options.find((o) => o.id === optionId);
+  if (!attr || !opt) return { ok: false, status: 404, body: { detail: "القيمة غير موجودة." } };
+  if ("value" in body) {
+    const value = str(body.value).trim();
+    const err = optionValueErrors(attr, value);
+    if (err) return { ok: false, status: 400, body: { value: err } };
+    opt.value = value;
+    if (opt.text_value !== null) opt.text_value = value;
+    if (opt.numeric_value !== null) opt.numeric_value = value;
+    if (opt.unit_value !== null) opt.unit_value = value;
+  }
+  if ("color" in body) opt.color = typeof body.color === "string" && body.color ? body.color : null;
+  if ("image" in body) opt.image = typeof body.image === "string" && body.image ? body.image : null;
+  return { ok: true, data: opt };
+}
+
+export function deleteOption(store: string | null, optionId: number): MockResult<null> {
+  const state = catalog(store);
+  const used = new Set(state.variants.filter((v) => v.option_ids.includes(optionId)).map((v) => v.product_id)).size;
+  if (used > 0) {
+    return { ok: false, status: 409, body: { detail: `القيمة مستخدمة في متغيرات ${used} ${used === 1 ? "منتج" : "منتجات"}.` } };
+  }
+  for (const a of state.attributes) a.options = a.options.filter((o) => o.id !== optionId);
+  return { ok: true, status: 204, data: null };
+}
+
+// ── Templates ─────────────────────────────────────────────────────────────────────────
+export function listTemplates(store: string | null): ProductTemplate[] {
+  const state = catalog(store);
+  return state.templates.map((t) => ({
+    ...t,
+    products_count: state.products.filter((p) => p.blueprint_id === t.id).length,
+  }));
+}
+
+function templateFieldsFrom(body: Body): Record<string, string | boolean | number | null> {
+  const raw = body.fields;
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return {};
+  const out: Record<string, string | boolean | number | null> = {};
+  for (const [k, v] of Object.entries(raw as Record<string, unknown>)) {
+    if (typeof v === "string" || typeof v === "boolean" || typeof v === "number" || v === null) out[k] = v;
+  }
+  return out;
+}
+
+export function createTemplate(store: string | null, body: Body): MockResult<ProductTemplate> {
+  const state = catalog(store);
+  const name = str(body.name).trim();
+  if (!name) return { ok: false, status: 400, body: { name: ["أدخل اسم القالب."] } };
+  if (state.templates.some((t) => t.name === name)) return { ok: false, status: 400, body: { name: ["قالب بهذا الاسم موجود."] } };
+  let fields = templateFieldsFrom(body);
+  let attributeIds = Array.isArray(body.variant_attribute_ids) ? body.variant_attribute_ids.map(Number) : [];
+  const fromProduct = Number(body.from_product_id);
+  if (fromProduct) {
+    const p = state.products.find((x) => x.id === fromProduct);
+    if (p) {
+      fields = {
+        product_type: p.product_type,
+        unit: p.unit,
+        currency: p.currency,
+        payment_policy: p.payment_policy,
+        deposit_required: p.deposit_required,
+        is_taxable: p.is_taxable,
+        tax_rate: p.tax_rate,
+        low_stock_threshold: p.low_stock_threshold,
+        variant_display_style: p.variant_display_style,
+        is_free_shipping: p.is_free_shipping,
+        delivery_duration: p.delivery_duration,
+        weight: p.weight,
+        is_hazardous: p.is_hazardous,
+        hazard_class: p.hazard_class,
+      };
+      attributeIds = [...p.variant_attribute_ids];
+    }
+  }
+  const t = {
+    id: nextCatalogId(state, "template"),
+    name,
+    global_template_id: Number(body.global_template_id) || null,
+    variant_attribute_ids: attributeIds,
+    fields,
+    updated_at: now(),
+  };
+  state.templates.push(t);
+  return { ok: true, status: 201, data: { ...t, products_count: 0 } };
+}
+
+export function updateTemplate(store: string | null, id: number, body: Body): MockResult<ProductTemplate> {
+  const state = catalog(store);
+  const t = state.templates.find((x) => x.id === id);
+  if (!t) return { ok: false, status: 404, body: { detail: "القالب غير موجود." } };
+  if ("name" in body) {
+    const name = str(body.name).trim();
+    if (!name) return { ok: false, status: 400, body: { name: ["أدخل اسم القالب."] } };
+    t.name = name;
+  }
+  if ("fields" in body) t.fields = templateFieldsFrom(body);
+  if (Array.isArray(body.variant_attribute_ids)) t.variant_attribute_ids = body.variant_attribute_ids.map(Number);
+  t.updated_at = now();
+  return { ok: true, data: { ...t, products_count: state.products.filter((p) => p.blueprint_id === id).length } };
+}
+
+export function deleteTemplate(store: string | null, id: number): MockResult<null> {
+  const state = catalog(store);
+  state.templates = state.templates.filter((t) => t.id !== id);
+  for (const p of state.products) if (p.blueprint_id === id) p.blueprint_id = null;
+  return { ok: true, status: 204, data: null };
+}
+
+export function applyTemplate(store: string | null, id: number, productIds: number[]): MockResult<ApplyTemplateResult> {
+  const state = catalog(store);
+  const t = state.templates.find((x) => x.id === id);
+  if (!t) return { ok: false, status: 404, body: { detail: "القالب غير موجود." } };
+  let applied = 0;
+  const skipped: ApplyTemplateResult["skipped"] = [];
+  for (const pid of productIds) {
+    const p = state.products.find((x) => x.id === pid);
+    if (!p) {
+      skipped.push({ id: pid, reason: "غير موجود" });
+      continue;
+    }
+    if (p.is_auction && p.auction_status === "active") {
+      skipped.push({ id: pid, reason: "مزاد نشط" });
+      continue;
+    }
+    applyTemplateFields(p, t.fields);
+    p.blueprint_id = t.id;
+    p.updated_at = now();
+    applied += 1;
+  }
+  return { ok: true, data: { applied, skipped, fields: Object.keys(t.fields) } };
+}
+
+export function applyGlobal(store: string | null, id: number, globalId: number) {
+  const state = catalog(store);
+  const t = state.templates.find((x) => x.id === id);
+  const g = globalTemplates().find((x) => x.id === globalId);
+  if (!t || !g) return { ok: false as const, status: 404, body: { detail: "القالب أو القطاع غير موجود." } };
+  const added: string[] = [];
+  const existing: string[] = [];
+  for (const ga of g.attributes) {
+    let attr = state.attributes.find((a) => a.name === ga.name);
+    if (attr) existing.push(ga.name);
+    else {
+      attr = {
+        id: nextCatalogId(state, "attribute"),
+        name: ga.name,
+        field_type: ga.field_type,
+        data_type: ga.data_type,
+        unit: ga.data_type === "unit" ? "مل" : "",
+        min_value: null,
+        max_value: null,
+        is_required: false,
+        sort_order: state.attributes.length,
+        options: [],
+      };
+      state.attributes.push(attr);
+      added.push(ga.name);
+    }
+    for (const value of ga.values) {
+      if (!attr.options.some((o) => o.value === value)) {
+        attr.options.push({
+          id: nextCatalogId(state, "option"),
+          attribute_id: attr.id,
+          value,
+          text_value: ga.data_type === "text" ? value : null,
+          numeric_value: ga.data_type === "number" ? value : null,
+          unit_value: ga.data_type === "unit" ? value : null,
+          boolean_value: null,
+          date_value: null,
+          image: null,
+          color: null,
+        });
+      }
+    }
+    if (!t.variant_attribute_ids.includes(attr.id)) t.variant_attribute_ids.push(attr.id);
+  }
+  t.global_template_id = g.id;
+  t.updated_at = now();
+  return { ok: true as const, data: { added_attributes: added, existing_attributes: existing } };
+}
diff --git a/src/mocks/catalog/import.ts b/src/mocks/catalog/import.ts
new file mode 100644
index 0000000..a9e6463
--- /dev/null
+++ b/src/mocks/catalog/import.ts
@@ -0,0 +1,120 @@
+import type { MockResult } from "@/lib/bff/mock-route";
+import { isDecimal } from "@/lib/decimal";
+import type { ImportStatus, ImportUpload } from "@/features/products/schemas";
+import { createProduct, parseCsv } from "@/mocks/catalog/products";
+import { catalog } from "@/mocks/catalog/state";
+
+/**
+ * CSV import as a three-stage job (FR-04.13): upload → preview + column mapping → run, with
+ * a pollable status. NOTHING is written before `run` (SC-04.5). Rows are validated up front
+ * so the preview shows the error of every row.
+ */
+const KNOWN: Record<string, string> = {
+  name: "name",
+  الاسم: "name",
+  "اسم المنتج": "name",
+  name_en: "name_en",
+  sku: "sku",
+  barcode: "barcode",
+  الباركود: "barcode",
+  price: "price",
+  السعر: "price",
+  old_price: "old_price",
+  stock: "stock",
+  المخزون: "stock",
+  category: "category",
+  التصنيف: "category",
+  description: "description",
+  الوصف: "description",
+};
+
+function rowError(row: Record<string, string>, mapping: Record<string, string>): string | null {
+  const get = (field: string) => {
+    const col = Object.entries(mapping).find(([, f]) => f === field)?.[0];
+    return col ? (row[col] ?? "").trim() : "";
+  };
+  if (!get("name")) return "الاسم فارغ";
+  const price = get("price");
+  if (!price) return "السعر فارغ";
+  if (!isDecimal(price)) return `سعر غير صالح «${price}»`;
+  const stock = get("stock");
+  if (stock && !/^\d+(\.\d{1,3})?$/.test(stock)) return `مخزون غير صالح «${stock}»`;
+  return null;
+}
+
+export function uploadImport(store: string | null, fileName: string, text: string): MockResult<ImportUpload> {
+  const ext = fileName.split(".").pop()?.toLowerCase() ?? "";
+  if (!["csv", "tsv", "txt", "xlsx"].includes(ext)) {
+    return { ok: false, status: 400, body: { file: ["الصيغ المسموحة: csv, tsv, txt, xlsx"] } };
+  }
+  if (ext === "xlsx") {
+    return { ok: false, status: 400, body: { file: ["ملفات xlsx يقرؤها الخادم الحقيقي فقط؛ صدّرها CSV للتجربة المحلية."] } };
+  }
+  if (text.includes("�")) {
+    return { ok: false, status: 400, body: { file: ["الملف ليس بترميز UTF-8؛ احفظه بترميز UTF-8 ثم أعد الرفع."] } };
+  }
+  const table = parseCsv(text);
+  if (table.length < 2) return { ok: false, status: 400, body: { file: ["الملف لا يحوي صفوف بيانات."] } };
+  const columns = table[0]!.map((c) => c.trim());
+  const rows = table.slice(1).map((r) => Object.fromEntries(columns.map((c, i) => [c, r[i] ?? ""])));
+  const mapping: Record<string, string> = {};
+  for (const c of columns) {
+    const f = KNOWN[c.toLowerCase()] ?? KNOWN[c];
+    if (f) mapping[c] = f;
+  }
+  const state = catalog(store);
+  const id = `imp-${Date.now().toString(36)}-${state.imports.size + 1}`;
+  state.imports.set(id, { id, columns, rows, status: "previewed", done: 0, failed: [], mapping, startedAt: 0 });
+  const row_errors = rows
+    .map((r, i) => ({ row: i + 2, msg: rowError(r, mapping) }))
+    .filter((x): x is { row: number; msg: string } => x.msg !== null);
+  return {
+    ok: true,
+    status: 201,
+    data: { job_id: id, columns, preview: rows.slice(0, 20), total_rows: rows.length, suggested_mapping: mapping, row_errors },
+  };
+}
+
+export function runImport(store: string | null, jobId: string, mapping: Record<string, string>): MockResult<ImportStatus> {
+  const state = catalog(store);
+  const job = state.imports.get(jobId);
+  if (!job) return { ok: false, status: 404, body: { detail: "مهمة الاستيراد غير موجودة." } };
+  if (job.status === "running" || job.status === "done") return { ok: false, status: 409, body: { detail: "نُفِّذت هذه المهمة مسبقاً." } };
+  if (!Object.values(mapping).includes("name") || !Object.values(mapping).includes("price")) {
+    return { ok: false, status: 400, body: { mapping: ["طابِق عمودَي الاسم والسعر على الأقل."] } };
+  }
+  job.mapping = mapping;
+  job.status = "running";
+  job.startedAt = Date.now();
+  return { ok: true, data: { status: "running", done: 0, total: job.rows.length, failed: [] } };
+}
+
+/** Progress advances with wall-clock time (≈ 40 rows / 300ms) so the UI can poll it. */
+export function importStatus(store: string | null, jobId: string): MockResult<ImportStatus> {
+  const state = catalog(store);
+  const job = state.imports.get(jobId);
+  if (!job) return { ok: false, status: 404, body: { detail: "مهمة الاستيراد غير موجودة." } };
+  if (job.status === "running") {
+    const target = Math.min(job.rows.length, Math.floor(((Date.now() - job.startedAt) / 300) * 40) + 1);
+    const catByName = new Map(state.categories.map((c) => [c.name, c.id]));
+    while (job.done < target) {
+      const row = job.rows[job.done]!;
+      const err = rowError(row, job.mapping);
+      if (err) job.failed.push({ row: job.done + 2, msg: err });
+      else {
+        const body: Record<string, unknown> = { is_available: false };
+        for (const [col, field] of Object.entries(job.mapping)) {
+          const v = (row[col] ?? "").trim();
+          if (field === "category") body.category_id = catByName.get(v) ?? null;
+          else body[field] = v;
+        }
+        if (!body.stock) body.stock = "0";
+        const res = createProduct(store, body);
+        if (!res.ok) job.failed.push({ row: job.done + 2, msg: Object.values(res.body).flat().join("، ") });
+      }
+      job.done += 1;
+    }
+    if (job.done >= job.rows.length) job.status = "done";
+  }
+  return { ok: true, data: { status: job.status, done: job.done, total: job.rows.length, failed: job.failed } };
+}
diff --git a/src/mocks/catalog/organization.ts b/src/mocks/catalog/organization.ts
new file mode 100644
index 0000000..e115707
--- /dev/null
+++ b/src/mocks/catalog/organization.ts
@@ -0,0 +1,381 @@
+import type { MockResult } from "@/lib/bff/mock-route";
+import { displayMoney } from "@/mocks/_fixtures";
+import { FIXTURE_NOW } from "@/mocks/store-state";
+import {
+  BADGE_DEFAULT_COLOR,
+  BADGE_NAME_MAX,
+  CATEGORY_NAME_MAX,
+  HEX_RE,
+  SEO_LIMITS,
+  TAG_NAME_MAX,
+  slugify,
+  type Badge,
+  type Brand,
+  type Category,
+  type Collection,
+  type CollectionDetail,
+  type Tag,
+} from "@/features/organization/schemas";
+import { effectivePrice } from "@/mocks/catalog/products";
+import { catalog, nextCatalogId } from "@/mocks/catalog/state";
+
+/**
+ * M05 operations (all rows `[NEEDS BACKEND]`): category tree with reorder/nesting and cycle
+ * rejection, `reassign_to` on delete, brand/tag/collection/badge CRUD, tag merge, manual
+ * collections with ordered products. Counts are derived from the catalogue every time, so
+ * a product created in M04 shows up here without a reload (SC-05.5).
+ */
+type Body = Record<string, unknown>;
+const str = (v: unknown) => (typeof v === "string" ? v : v === null || v === undefined ? "" : String(v));
+const now = () => new Date(Math.max(Date.now(), FIXTURE_NOW)).toISOString();
+
+// ── Categories ────────────────────────────────────────────────────────────────────────
+export function listCategories(store: string | null): Category[] {
+  const state = catalog(store);
+  return [...state.categories]
+    .sort((a, b) => (a.parent_id ?? 0) - (b.parent_id ?? 0) || a.sort_order - b.sort_order)
+    .map((c) => ({ ...c, products_count: state.products.filter((p) => p.category_id === c.id).length }));
+}
+
+function seoErrors(body: Body): Record<string, string[]> {
+  const e: Record<string, string[]> = {};
+  for (const [k, max] of Object.entries(SEO_LIMITS)) {
+    if (str(body[k]).length > max) e[k] = [`${max} حرفاً على الأكثر.`];
+  }
+  return e;
+}
+
+function isDescendant(state: ReturnType<typeof catalog>, candidate: number, of: number): boolean {
+  let cur = state.categories.find((c) => c.id === candidate);
+  const seen = new Set<number>();
+  while (cur && cur.parent_id !== null && !seen.has(cur.id)) {
+    seen.add(cur.id);
+    if (cur.parent_id === of) return true;
+    cur = state.categories.find((c) => c.id === cur!.parent_id);
+  }
+  return false;
+}
+
+export function createCategory(store: string | null, body: Body): MockResult<Category> {
+  const state = catalog(store);
+  const name = str(body.name).trim();
+  const e = seoErrors(body);
+  if (!name) e.name = ["أدخل اسم التصنيف."];
+  else if (name.length > CATEGORY_NAME_MAX) e.name = [`الاسم ${CATEGORY_NAME_MAX} حرفاً على الأكثر.`];
+  const parent = body.parent_id === null || body.parent_id === undefined || body.parent_id === "" ? null : Number(body.parent_id);
+  if (parent !== null && !state.categories.some((c) => c.id === parent)) e.parent_id = ["التصنيف الأب غير موجود."];
+  if (state.categories.some((c) => c.name === name && c.parent_id === parent)) e.name = ["تصنيف بهذا الاسم موجود في نفس المستوى."];
+  if (Object.keys(e).length) return { ok: false, status: 400, body: e };
+  const siblings = state.categories.filter((c) => c.parent_id === parent);
+  const cat = {
+    id: nextCatalogId(state, "category"),
+    name,
+    parent_id: parent,
+    sort_order: siblings.length,
+    image: typeof body.image === "string" && body.image ? body.image : null,
+    meta_title: str(body.meta_title),
+    meta_description: str(body.meta_description),
+    meta_keywords: str(body.meta_keywords),
+    og_image: typeof body.og_image === "string" && body.og_image ? body.og_image : null,
+  };
+  state.categories.push(cat);
+  return { ok: true, status: 201, data: { ...cat, products_count: 0 } };
+}
+
+export function updateCategory(store: string | null, id: number, body: Body): MockResult<Category> {
+  const state = catalog(store);
+  const cat = state.categories.find((c) => c.id === id);
+  if (!cat) return { ok: false, status: 404, body: { detail: "التصنيف غير موجود." } };
+  const e = seoErrors(body);
+  if ("name" in body) {
+    const name = str(body.name).trim();
+    if (!name) e.name = ["أدخل اسم التصنيف."];
+    else if (name.length > CATEGORY_NAME_MAX) e.name = [`الاسم ${CATEGORY_NAME_MAX} حرفاً على الأكثر.`];
+  }
+  if ("parent_id" in body) {
+    const parent = body.parent_id === null || body.parent_id === "" ? null : Number(body.parent_id);
+    if (parent === id || (parent !== null && isDescendant(state, parent, id))) {
+      e.parent_id = ["لا يمكن نقل التصنيف داخل أحد فروعه."];
+    }
+  }
+  if (Object.keys(e).length) return { ok: false, status: 400, body: e };
+  if ("name" in body) cat.name = str(body.name).trim();
+  if ("parent_id" in body) cat.parent_id = body.parent_id === null || body.parent_id === "" ? null : Number(body.parent_id);
+  if ("image" in body) cat.image = typeof body.image === "string" && body.image ? body.image : null;
+  if ("og_image" in body) cat.og_image = typeof body.og_image === "string" && body.og_image ? body.og_image : null;
+  for (const k of ["meta_title", "meta_description", "meta_keywords"] as const) if (k in body) cat[k] = str(body[k]);
+  return { ok: true, data: { ...cat, products_count: state.products.filter((p) => p.category_id === id).length } };
+}
+
+/**
+ * `DELETE /categories/<id>/?reassign_to=<id>|none&children=lift|grandparent`.
+ * Products move to `reassign_to` (or stay uncategorized); children rise to the parent.
+ */
+export function deleteCategory(store: string | null, id: number, params: URLSearchParams): MockResult<{ moved_products: number }> {
+  const state = catalog(store);
+  const cat = state.categories.find((c) => c.id === id);
+  if (!cat) return { ok: false, status: 404, body: { detail: "التصنيف غير موجود." } };
+  const affected = state.products.filter((p) => p.category_id === id);
+  const reassignRaw = params.get("reassign_to");
+  if (affected.length > 0 && reassignRaw === null) {
+    return {
+      ok: false,
+      status: 409,
+      body: { detail: "للتصنيف منتجات؛ اختر نقلها أو إبقاءها بلا تصنيف.", products_count: affected.length },
+    };
+  }
+  const target = reassignRaw && reassignRaw !== "none" ? Number(reassignRaw) : null;
+  if (target === id) return { ok: false, status: 400, body: { reassign_to: ["اختر تصنيفاً آخر."] } };
+  const childMode = params.get("children") === "root" ? "root" : "grandparent";
+  for (const p of affected) p.category_id = target;
+  for (const child of state.categories.filter((c) => c.parent_id === id)) {
+    child.parent_id = childMode === "root" ? null : cat.parent_id;
+  }
+  state.categories = state.categories.filter((c) => c.id !== id);
+  return { ok: true, data: { moved_products: affected.length } };
+}
+
+export function reorderCategories(store: string | null, body: Body): MockResult<Category[]> {
+  const state = catalog(store);
+  const moves = Array.isArray(body.moves) ? (body.moves as Array<Record<string, unknown>>) : [];
+  // Validate against the post-move tree: no category may become its own ancestor.
+  const parentOf = new Map(state.categories.map((c) => [c.id, c.parent_id]));
+  for (const m of moves) {
+    const id = Number(m.id);
+    if (!parentOf.has(id)) return { ok: false, status: 400, body: { detail: "تصنيف غير موجود في الترتيب." } };
+    parentOf.set(id, m.parent_id === null || m.parent_id === undefined ? null : Number(m.parent_id));
+  }
+  for (const start of parentOf.keys()) {
+    const seen = new Set<number>();
+    let cur: number | null | undefined = start;
+    while (cur !== null && cur !== undefined) {
+      if (seen.has(cur)) return { ok: false, status: 400, body: { detail: "الترتيب يُنشئ دورة: لا يمكن وضع تصنيف داخل أحد فروعه." } };
+      seen.add(cur);
+      cur = parentOf.get(cur);
+    }
+  }
+  for (const m of moves) {
+    const cat = state.categories.find((c) => c.id === Number(m.id))!;
+    cat.parent_id = m.parent_id === null || m.parent_id === undefined ? null : Number(m.parent_id);
+    cat.sort_order = Number(m.sort_order) || 0;
+  }
+  return { ok: true, data: listCategories(store) };
+}
+
+// ── Brands ────────────────────────────────────────────────────────────────────────────
+export function listBrands(store: string | null): Brand[] {
+  const state = catalog(store);
+  return state.brands.map((b) => ({ ...b, products_count: state.products.filter((p) => p.brand_id === b.id).length }));
+}
+
+export function saveBrand(store: string | null, id: number | null, body: Body): MockResult<Brand> {
+  const state = catalog(store);
+  const existing = id === null ? undefined : state.brands.find((b) => b.id === id);
+  if (id !== null && !existing) return { ok: false, status: 404, body: { detail: "الماركة غير موجودة." } };
+  const name = "name" in body ? str(body.name).trim() : (existing?.name ?? "");
+  const slug = "slug" in body ? slugify(str(body.slug)) : (existing?.slug ?? "");
+  const e: Record<string, string[]> = {};
+  if (!name) e.name = ["أدخل اسم الماركة."];
+  if (state.brands.some((b) => b.name === name && b.id !== id)) e.name = ["ماركة بهذا الاسم موجودة."];
+  const finalSlug = slug || slugify(name) || `brand-${state.ids.brand + 1}`;
+  if (state.brands.some((b) => b.slug === finalSlug && b.id !== id)) e.slug = ["هذا الـ slug مستخدم؛ جرّب لاحقة مختلفة."];
+  if (Object.keys(e).length) return { ok: false, status: 400, body: e };
+  const logo = "logo" in body ? (typeof body.logo === "string" && body.logo ? body.logo : null) : (existing?.logo ?? null);
+  if (existing) {
+    Object.assign(existing, { name, slug: finalSlug, logo });
+    return { ok: true, data: { ...existing, products_count: state.products.filter((p) => p.brand_id === existing.id).length } };
+  }
+  const brand = { id: nextCatalogId(state, "brand"), name, slug: finalSlug, logo };
+  state.brands.push(brand);
+  return { ok: true, status: 201, data: { ...brand, products_count: 0 } };
+}
+
+export function deleteBrand(store: string | null, id: number): MockResult<{ cleared: number }> {
+  const state = catalog(store);
+  let cleared = 0;
+  for (const p of state.products) {
+    if (p.brand_id === id) {
+      p.brand_id = null;
+      cleared++;
+    }
+  }
+  state.brands = state.brands.filter((b) => b.id !== id);
+  return { ok: true, data: { cleared } };
+}
+
+// ── Tags ──────────────────────────────────────────────────────────────────────────────
+export function listTags(store: string | null): Tag[] {
+  const state = catalog(store);
+  return state.tags.map((t) => {
+    const products = state.products.filter((p) => p.tag_ids.includes(t.id));
+    const last = products.map((p) => p.updated_at).sort().at(-1) ?? null;
+    return { ...t, products_count: products.length, last_used_at: last };
+  });
+}
+
+export function saveTag(store: string | null, id: number | null, body: Body): MockResult<Tag> {
+  const state = catalog(store);
+  const existing = id === null ? undefined : state.tags.find((t) => t.id === id);
+  if (id !== null && !existing) return { ok: false, status: 404, body: { detail: "الوسم غير موجود." } };
+  const name = str(body.name).trim();
+  if (!name) return { ok: false, status: 400, body: { name: ["أدخل اسم الوسم."] } };
+  if (name.length > TAG_NAME_MAX) return { ok: false, status: 400, body: { name: [`الاسم ${TAG_NAME_MAX} حرفاً على الأكثر.`] } };
+  if (state.tags.some((t) => t.name === name && t.id !== id)) return { ok: false, status: 400, body: { name: ["وسم بهذا الاسم موجود."] } };
+  const slug = slugify(str(body.slug)) || existing?.slug || slugify(name) || `tag-${state.ids.tag + 1}`;
+  if (existing) {
+    Object.assign(existing, { name, slug });
+    return { ok: true, data: listTags(store).find((t) => t.id === existing.id)! };
+  }
+  const tag = { id: nextCatalogId(state, "tag"), name, slug };
+  state.tags.push(tag);
+  return { ok: true, status: 201, data: { ...tag, products_count: 0, last_used_at: null } };
+}
+
+export function deleteTag(store: string | null, id: number): MockResult<{ cleared: number }> {
+  const state = catalog(store);
+  let cleared = 0;
+  for (const p of state.products) {
+    if (p.tag_ids.includes(id)) {
+      p.tag_ids = p.tag_ids.filter((t) => t !== id);
+      cleared++;
+    }
+  }
+  state.tags = state.tags.filter((t) => t.id !== id);
+  return { ok: true, data: { cleared } };
+}
+
+export function mergeTags(store: string | null, fromId: number, intoId: number): MockResult<{ moved: number }> {
+  const state = catalog(store);
+  if (fromId === intoId) return { ok: false, status: 400, body: { into_id: ["اختر وسماً مختلفاً."] } };
+  if (!state.tags.some((t) => t.id === fromId) || !state.tags.some((t) => t.id === intoId)) {
+    return { ok: false, status: 404, body: { detail: "الوسم غير موجود." } };
+  }
+  let moved = 0;
+  for (const p of state.products) {
+    if (p.tag_ids.includes(fromId)) {
+      p.tag_ids = p.tag_ids.filter((t) => t !== fromId);
+      if (!p.tag_ids.includes(intoId)) p.tag_ids.push(intoId);
+      moved++;
+    }
+  }
+  state.tags = state.tags.filter((t) => t.id !== fromId);
+  return { ok: true, data: { moved } };
+}
+
+// ── Collections ───────────────────────────────────────────────────────────────────────
+export function listCollections(store: string | null): Collection[] {
+  const state = catalog(store);
+  return state.collections.map(({ product_ids, ...c }) => ({ ...c, products_count: product_ids.length }));
+}
+
+export function collectionDetail(store: string | null, id: number): CollectionDetail | null {
+  const state = catalog(store);
+  const c = state.collections.find((x) => x.id === id);
+  if (!c) return null;
+  const { product_ids, ...rest } = c;
+  return {
+    ...rest,
+    products_count: product_ids.length,
+    products: product_ids
+      .map((pid) => state.products.find((p) => p.id === pid))
+      .filter((p): p is NonNullable<typeof p> => Boolean(p))
+      .map((p) => ({
+        id: p.id,
+        name: p.name,
+        sku: p.sku,
+        image: p.images[0]?.url ?? null,
+        display_price: displayMoney(Number(effectivePrice(p)), p.currency),
+        is_archived: Boolean(p.archived_at),
+      })),
+  };
+}
+
+export function saveCollection(store: string | null, id: number | null, body: Body): MockResult<Collection> {
+  const state = catalog(store);
+  const existing = id === null ? undefined : state.collections.find((c) => c.id === id);
+  if (id !== null && !existing) return { ok: false, status: 404, body: { detail: "المجموعة غير موجودة." } };
+  const name = "name" in body ? str(body.name).trim() : (existing?.name ?? "");
+  if (!name) return { ok: false, status: 400, body: { name: ["أدخل اسم المجموعة."] } };
+  const slug = slugify(str(body.slug)) || existing?.slug || slugify(name) || `collection-${state.ids.collection + 1}`;
+  if (state.collections.some((c) => c.slug === slug && c.id !== id)) return { ok: false, status: 400, body: { slug: ["هذا الـ slug مستخدم."] } };
+  const description = "description" in body ? str(body.description) : (existing?.description ?? "");
+  if (existing) {
+    Object.assign(existing, { name, slug, description });
+    return { ok: true, data: listCollections(store).find((c) => c.id === existing.id)! };
+  }
+  const coll = { id: nextCatalogId(state, "collection"), name, slug, description, product_ids: [] as number[] };
+  state.collections.push(coll);
+  return { ok: true, status: 201, data: { id: coll.id, name, slug, description, products_count: 0 } };
+}
+
+export function deleteCollection(store: string | null, id: number): MockResult<null> {
+  const state = catalog(store);
+  state.collections = state.collections.filter((c) => c.id !== id);
+  return { ok: true, status: 204, data: null };
+}
+
+export function collectionAdd(store: string | null, id: number, productIds: number[]): MockResult<CollectionDetail> {
+  const state = catalog(store);
+  const c = state.collections.find((x) => x.id === id);
+  if (!c) return { ok: false, status: 404, body: { detail: "المجموعة غير موجودة." } };
+  for (const pid of productIds) if (!c.product_ids.includes(pid) && state.products.some((p) => p.id === pid)) c.product_ids.push(pid);
+  return { ok: true, data: collectionDetail(store, id)! };
+}
+
+export function collectionRemove(store: string | null, id: number, productId: number): MockResult<CollectionDetail> {
+  const state = catalog(store);
+  const c = state.collections.find((x) => x.id === id);
+  if (!c) return { ok: false, status: 404, body: { detail: "المجموعة غير موجودة." } };
+  c.product_ids = c.product_ids.filter((p) => p !== productId);
+  return { ok: true, data: collectionDetail(store, id)! };
+}
+
+export function collectionReorder(store: string | null, id: number, ordered: number[]): MockResult<CollectionDetail> {
+  const state = catalog(store);
+  const c = state.collections.find((x) => x.id === id);
+  if (!c) return { ok: false, status: 404, body: { detail: "المجموعة غير موجودة." } };
+  const kept = ordered.filter((pid) => c.product_ids.includes(pid));
+  c.product_ids = [...kept, ...c.product_ids.filter((pid) => !kept.includes(pid))];
+  return { ok: true, data: collectionDetail(store, id)! };
+}
+
+// ── Badges ────────────────────────────────────────────────────────────────────────────
+export function listBadges(store: string | null): Badge[] {
+  const state = catalog(store);
+  return state.badges.map((b) => ({ ...b, products_count: state.products.filter((p) => p.badge_ids.includes(b.id)).length }));
+}
+
+export function saveBadge(store: string | null, id: number | null, body: Body): MockResult<Badge> {
+  const state = catalog(store);
+  const existing = id === null ? undefined : state.badges.find((b) => b.id === id);
+  if (id !== null && !existing) return { ok: false, status: 404, body: { detail: "الشارة غير موجودة." } };
+  const name = "name" in body ? str(body.name).trim() : (existing?.name ?? "");
+  const color = "color" in body ? str(body.color) : (existing?.color ?? BADGE_DEFAULT_COLOR);
+  const e: Record<string, string[]> = {};
+  if (!name) e.name = ["أدخل اسم الشارة."];
+  else if (name.length > BADGE_NAME_MAX) e.name = [`الاسم ${BADGE_NAME_MAX} حرفاً على الأكثر.`];
+  if (!HEX_RE.test(color)) e.color = ["لون بصيغة #RRGGBB."];
+  if (Object.keys(e).length) return { ok: false, status: 400, body: e };
+  if (existing) {
+    Object.assign(existing, { name, color });
+    return { ok: true, data: listBadges(store).find((b) => b.id === existing.id)! };
+  }
+  const badge = { id: nextCatalogId(state, "badge"), name, color };
+  state.badges.push(badge);
+  return { ok: true, status: 201, data: { ...badge, products_count: 0 } };
+}
+
+export function deleteBadge(store: string | null, id: number): MockResult<{ cleared: number }> {
+  const state = catalog(store);
+  let cleared = 0;
+  for (const p of state.products) {
+    if (p.badge_ids.includes(id)) {
+      p.badge_ids = p.badge_ids.filter((b) => b !== id);
+      cleared++;
+    }
+  }
+  state.badges = state.badges.filter((b) => b.id !== id);
+  return { ok: true, data: { cleared } };
+}
+
+export { now as organizationNow };
