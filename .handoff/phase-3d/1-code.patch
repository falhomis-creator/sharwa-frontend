@@ -0,0 +1,55 @@
+"use client";
+
+import { parseAsInteger, parseAsString, parseAsStringLiteral, useQueryStates } from "nuqs";
+import { ORDER_STATUSES, PAYMENT_STATUSES, SALES_CHANNELS, TRAFFIC_SOURCES } from "@/features/orders/schemas";
+
+/**
+ * Order list filters in the URL (FR-06.01/02, SC-06.5): a copied link reproduces the exact
+ * view. Keys are the API's own query names. `order` is the id open in the side sheet
+ * (US-06.1.3) — URL state, so Next 16's preserved routes never reopen a stale sheet.
+ */
+export const orderFilterParsers = {
+  q: parseAsString.withDefault(""),
+  status: parseAsStringLiteral(ORDER_STATUSES),
+  payment_status: parseAsStringLiteral(PAYMENT_STATUSES),
+  fulfillment_status: parseAsString.withDefault(""),
+  channel: parseAsStringLiteral(SALES_CHANNELS),
+  traffic_source: parseAsStringLiteral(TRAFFIC_SOURCES),
+  location: parseAsString.withDefault(""),
+  from: parseAsString.withDefault(""),
+  to: parseAsString.withDefault(""),
+};
+
+export function useOrderFilters() {
+  const [filters, setFilters] = useQueryStates(orderFilterParsers, { history: "replace" });
+  const activeCount =
+    Number(Boolean(filters.status)) +
+    Number(Boolean(filters.payment_status)) +
+    Number(Boolean(filters.fulfillment_status)) +
+    Number(Boolean(filters.channel)) +
+    Number(Boolean(filters.traffic_source)) +
+    Number(Boolean(filters.location)) +
+    Number(Boolean(filters.from || filters.to));
+  return {
+    filters,
+    setFilters,
+    activeCount,
+    isFiltered: activeCount > 0 || Boolean(filters.q),
+    clear: () =>
+      setFilters({
+        q: null,
+        status: null,
+        payment_status: null,
+        fulfillment_status: null,
+        channel: null,
+        traffic_source: null,
+        location: null,
+        from: null,
+        to: null,
+      }),
+  };
+}
+
+export function useOpenOrder() {
+  return useQueryStates({ order: parseAsInteger }, { history: "push" });
+}
diff --git a/src/features/orders/hooks/use-order-write.ts b/src/features/orders/hooks/use-order-write.ts
new file mode 100644
index 0000000..e29dcde
--- /dev/null
+++ b/src/features/orders/hooks/use-order-write.ts
@@ -0,0 +1,70 @@
+"use client";
+
+import { useState } from "react";
+import { toast } from "sonner";
+import { apiFetch } from "@/lib/api-client";
+import { isApiError } from "@/lib/api-error";
+import { orderDetailSchema, type OrderDetail } from "@/features/orders/schemas";
+import { useApplyOrder } from "@/features/orders/api";
+
+/**
+ * Every order write goes through here (FR-06.06): it sends the `version` the screen holds;
+ * a 409 does NOT retry silently — it parks the write and shows the conflict panel
+ * «حُدِّث الطلب من مستخدم آخر» with «تحديث ثم إعادة المحاولة», which reloads the order and
+ * re-sends the same write with the fresh `version` (US-06.3.5).
+ */
+export interface PendingConflict {
+  orderId: number;
+  label: string;
+  write: (version: number) => Promise<OrderDetail>;
+  success: string;
+}
+
+export function useOrderWrite() {
+  const apply = useApplyOrder();
+  const [conflict, setConflict] = useState<PendingConflict | null>(null);
+  const [pending, setPending] = useState(false);
+
+  async function run(
+    orderId: number,
+    version: number,
+    write: (version: number) => Promise<OrderDetail>,
+    opts: { success: string; label: string },
+  ): Promise<OrderDetail | null> {
+    setPending(true);
+    try {
+      const order = await write(version);
+      apply(order);
+      setConflict(null);
+      toast.success(opts.success);
+      return order;
+    } catch (err) {
+      if (isApiError(err) && err.status === 409) {
+        setConflict({ orderId, write, success: opts.success, label: opts.label });
+        // Show the other user's change right away; the retry re-applies ours on top.
+        void apiFetch(`/api/bff/orders/${orderId}`, orderDetailSchema).then(apply, () => undefined);
+        return null;
+      }
+      toast.error(isApiError(err) ? err.userMessage : "تعذّر الحفظ.");
+      return null;
+    } finally {
+      setPending(false);
+    }
+  }
+
+  async function retryConflict() {
+    if (!conflict) return null;
+    setPending(true);
+    try {
+      const fresh = await apiFetch(`/api/bff/orders/${conflict.orderId}`, orderDetailSchema);
+      apply(fresh);
+      return await run(conflict.orderId, fresh.version, conflict.write, conflict);
+    } catch (err) {
+      toast.error(isApiError(err) ? err.userMessage : "تعذّر تحديث الطلب.");
+      setPending(false);
+      return null;
+    }
+  }
+
+  return { run, conflict, retryConflict, dismissConflict: () => setConflict(null), pending };
+}
