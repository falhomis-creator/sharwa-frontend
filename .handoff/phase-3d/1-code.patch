+
+/** `PATCH/DELETE /api/v1/badges/<id>/` — DELETE removes it from its products and reports how many (FR-05.09). */
+export async function PATCH(request: Request, { params }: RouteContext<"/api/bff/badges/[id]">) {
+  const id = Number((await params).id);
+  return mockRoute(request, async ({ store, session }) => {
+    if (!canManageCatalog(session)) return forbidden();
+    return respond(saveBadge(store, id, await readBody(request)));
+  });
+}
