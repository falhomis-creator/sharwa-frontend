+++ b/src/app/api/bff/tags/route.ts
@@ -0,0 +1,15 @@
+import { canManageCatalog, forbidden, mockRoute, readBody, respond } from "@/lib/bff/mock-route";
+import { mockJson } from "@/mocks/runtime";
+import { listTags, saveTag } from "@/mocks/catalog/organization";
+
+/** `GET/POST /api/v1/tags/` (M05 §7 — `[NEEDS BACKEND]`). */
+export async function GET(request: Request) {
+  return mockRoute(request, ({ store }) => mockJson(listTags(store), { delay: 150 }));
+}
+
+export async function POST(request: Request) {
+  return mockRoute(request, async ({ store, session }) => {
+    if (!canManageCatalog(session)) return forbidden();
+    return respond(saveTag(store, null, await readBody(request)));
+  });
+}
diff --git a/src/components/shared/data-table/bulk-action-dialog.tsx b/src/components/shared/data-table/bulk-action-dialog.tsx
new file mode 100644
index 0000000..f1b936d
--- /dev/null
+++ b/src/components/shared/data-table/bulk-action-dialog.tsx
@@ -0,0 +1,139 @@
+"use client";
+
+import { useState, type ReactNode } from "react";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogTitle } from "@/components/ui/dialog";
+import { Mono } from "@/components/shared/mono";
+import { isApiError } from "@/lib/api-error";
+import { formatNumber } from "@/lib/format";
+
+/**
+ * Bulk action flow (FR-04.12, FR-06.05): preview by count → run → report
+ * «18 نجحت، 2 مرفوضة» with the reason of every rejection. Nothing runs before the
+ * confirmation; a network failure keeps the dialog open with a retry.
+ */
+export interface BulkReport {
+  succeeded: number;
+  failed: Array<{ id: string | number; label?: string; reason: string }>;
+}
+
+export function BulkActionDialog({
+  open,
+  onOpenChange,
+  title,
+  count,
+  description,
+  confirmLabel,
+  destructive = false,
+  children,
+  run,
+  onDone,
+  confirmDisabled = false,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: string;
+  count: number;
+  description?: string;
+  confirmLabel: string;
+  destructive?: boolean;
+  /** Extra inputs (target category, tag…) rendered under the preview. */
+  children?: ReactNode;
+  run: () => Promise<BulkReport>;
+  onDone?: (report: BulkReport) => void;
+  /** e.g. a required target (status, category) is not chosen yet. */
+  confirmDisabled?: boolean;
+}) {
+  const [phase, setPhase] = useState<"preview" | "running" | "report">("preview");
+  const [report, setReport] = useState<BulkReport | null>(null);
+  const [error, setError] = useState("");
+
+  function reset(next: boolean) {
+    onOpenChange(next);
+    if (!next) {
+      setPhase("preview");
+      setReport(null);
+      setError("");
+    }
+  }
+
+  async function confirm() {
+    setPhase("running");
+    setError("");
+    try {
+      const result = await run();
+      setReport(result);
+      setPhase("report");
+      onDone?.(result);
+    } catch (err) {
+      setError(isApiError(err) ? err.userMessage : "تعذّر تنفيذ الإجراء.");
+      setPhase("preview");
+    }
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={reset}>
+      <DialogContent className="sm:max-w-md" data-testid="bulk-dialog">
+        <DialogTitle>{title}</DialogTitle>
+        {phase !== "report" ? (
+          <>
+            <DialogDescription>
+              سيُطبَّق على <Mono className="text-foreground">{formatNumber(count)}</Mono>{" "}
+              {count === 1 ? "عنصر محدد" : "عناصر محددة"}.{description ? ` ${description}` : ""}
+            </DialogDescription>
+            {children}
+            {error ? (
+              <p role="alert" className="text-sm text-destructive">
+                {error}
+              </p>
+            ) : null}
+            <DialogFooter>
+              <Button variant="outline" size="lg" className="h-11 lg:h-9" onClick={() => reset(false)}>
+                إلغاء
+              </Button>
+              <Button
+                variant={destructive ? "destructive" : "default"}
+                size="lg"
+                className="h-11 lg:h-9"
+                disabled={phase === "running" || confirmDisabled}
+                onClick={() => void confirm()}
+                data-testid="bulk-confirm"
+              >
+                {phase === "running" ? "جارٍ التنفيذ…" : confirmLabel}
+              </Button>
+            </DialogFooter>
+          </>
+        ) : report ? (
+          <>
+            <div role="status" className="flex flex-col gap-3" data-testid="bulk-report">
+              <p className="text-sm">
+                <Mono className="text-success">{formatNumber(report.succeeded)}</Mono> نجحت
+                {report.failed.length > 0 ? (
+                  <>
+                    {"، "}
+                    <Mono className="text-destructive">{formatNumber(report.failed.length)}</Mono> مرفوضة
+                  </>
+                ) : null}
+              </p>
+              {report.failed.length > 0 ? (
+                <ul className="max-h-48 divide-y divide-border overflow-y-auto rounded-md border border-border text-sm">
+                  {report.failed.map((f) => (
+                    <li key={String(f.id)} className="flex items-start justify-between gap-3 px-3 py-2">
+                      <span className="min-w-0 truncate">{f.label ?? <Mono>#{f.id}</Mono>}</span>
+                      <span className="shrink-0 text-muted-foreground">{f.reason}</span>
+                    </li>
+                  ))}
+                </ul>
+              ) : null}
+            </div>
+            <DialogFooter>
+              <Button size="lg" className="h-11 lg:h-9" onClick={() => reset(false)}>
+                تم
+              </Button>
+            </DialogFooter>
+          </>
+        ) : null}
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/src/components/shared/data-table/data-table.tsx b/src/components/shared/data-table/data-table.tsx
new file mode 100644
index 0000000..6937c50
--- /dev/null
+++ b/src/components/shared/data-table/data-table.tsx
@@ -0,0 +1,403 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import {
+  flexRender,
+  getCoreRowModel,
+  useReactTable,
+  type ColumnDef,
+  type RowSelectionState,
+} from "@tanstack/react-table";
+import { ArrowDown, ArrowUp, ArrowUpDown, Rows3, Rows4, X } from "lucide-react";
+import { Checkbox } from "@/components/ui/checkbox";
+import { Skeleton } from "@/components/ui/skeleton";
+import { ErrorState } from "@/components/shared/error-state";
+import { Mono } from "@/components/shared/mono";
+import { TablePagination } from "@/components/shared/data-table/table-pagination";
+import { nextOrdering, type Density } from "@/components/shared/data-table/use-table-url-state";
+import { formatNumber } from "@/lib/format";
+import { cn } from "@/lib/utils";
+
+/**
+ * Shared data table (T069) on TanStack Table 8 — the one table every dashboard list uses.
+ *
+ * Constitution › الجداول: 44px rows, a sticky header, horizontal hairlines only, numeric
+ * columns `text-end font-mono`, switchable density. Server-driven: the caller owns the
+ * data, the page and the ordering (URL state via nuqs); this component only renders and
+ * reports intent. Multi-select drives a bulk bar that previews by count.
+ *
+ * States: skeleton · empty (no data at all) · no results (filters active) · error · no
+ * permission. Below `md` a `renderMobileCard` replaces the table (M04/M06 §6 «الجوال»).
+ *
+ * Keyboard (M04/M06 §6): `J`/`K` move between rows, `Enter`/`Space` open the focused row.
+ */
+export interface DataTableProps<T> {
+  columns: ColumnDef<T, unknown>[];
+  data: T[] | undefined;
+  getRowId: (row: T) => string;
+  /** Accessible name of the table. */
+  caption: string;
+  total: number;
+  page: number;
+  pageSize: number;
+  onPageChange: (page: number) => void;
+  onPageSizeChange?: (size: number) => void;
+  ordering?: string;
+  onOrderingChange?: (ordering: string) => void;
+  density?: Density;
+  onDensityChange?: (density: Density) => void;
+  isLoading: boolean;
+  isFetching?: boolean;
+  error?: unknown;
+  onRetry?: () => void;
+  forbidden?: boolean;
+  /** Rendered when the list has no data at all (no filters). */
+  emptyState?: ReactNode;
+  /** Rendered when filters/search produced nothing. */
+  noResultsState?: ReactNode;
+  isFiltered?: boolean;
+  selectable?: boolean;
+  rowSelection?: RowSelectionState;
+  onRowSelectionChange?: (selection: RowSelectionState) => void;
+  /** The bulk bar's action buttons, given the selected ids. */
+  bulkActions?: (ids: string[]) => ReactNode;
+  renderMobileCard?: (row: T) => ReactNode;
+  onRowOpen?: (row: T) => void;
+  /** Toolbar content rendered above the table (filters, search). */
+  toolbar?: ReactNode;
+  testId?: string;
+}
+
+const ROW_HEIGHT: Record<Density, string> = { comfortable: "h-11", compact: "h-9" };
+
+function isTyping(target: EventTarget | null): boolean {
+  if (!(target instanceof HTMLElement)) return false;
+  const tag = target.tagName;
+  return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || target.isContentEditable;
+}
+
+export function DataTable<T>({
+  columns,
+  data,
+  getRowId,
+  caption,
+  total,
+  page,
+  pageSize,
+  onPageChange,
+  onPageSizeChange,
+  ordering = "",
+  onOrderingChange,
+  density = "comfortable",
+  onDensityChange,
+  isLoading,
+  isFetching = false,
+  error,
+  onRetry,
+  forbidden = false,
+  emptyState,
+  noResultsState,
+  isFiltered = false,
+  selectable = false,
+  rowSelection,
+  onRowSelectionChange,
+  bulkActions,
+  renderMobileCard,
+  onRowOpen,
+  toolbar,
+  testId,
+}: DataTableProps<T>) {
+  const [localSelection, setLocalSelection] = useState<RowSelectionState>({});
+  const selection = rowSelection ?? localSelection;
+  const setSelection = onRowSelectionChange ?? setLocalSelection;
+  const bodyRef = useRef<HTMLTableSectionElement>(null);
+  const mobileRef = useRef<HTMLUListElement>(null);
+
+  const selectionColumn = useMemo<ColumnDef<T, unknown>>(
+    () => ({
+      id: "__select",
+      meta: { srOnlyHeader: true, className: "w-10" },
+      header: ({ table }) => (
+        <span className="flex items-center justify-center">
+          <Checkbox
+            aria-label="تحديد كل صفوف الصفحة"
+            checked={table.getIsAllPageRowsSelected()}
+            indeterminate={table.getIsSomePageRowsSelected()}
+            onCheckedChange={(v) => table.toggleAllPageRowsSelected(Boolean(v))}
+          />
+        </span>
+      ),
+      cell: ({ row }) => (
+        <span className="flex items-center justify-center" onClick={(e) => e.stopPropagation()}>
+          <Checkbox
+            aria-label="تحديد الصف"
+            checked={row.getIsSelected()}
+            onCheckedChange={(v) => row.toggleSelected(Boolean(v))}
+          />
+        </span>
+      ),
+    }),
+    [],
+  );
+
+  // TanStack Table returns fresh functions each render; React Compiler skips this component
+  // on purpose, which is the correct behaviour for a table.
+  // eslint-disable-next-line react-hooks/incompatible-library
+  const table = useReactTable<T>({
+    data: data ?? [],
+    columns: selectable ? [selectionColumn, ...columns] : columns,
+    getRowId,
+    getCoreRowModel: getCoreRowModel(),
+    manualPagination: true,
+    manualSorting: true,
+    rowCount: total,
+    enableRowSelection: selectable,
+    state: { rowSelection: selection },
+    onRowSelectionChange: (updater) => {
+      setSelection(typeof updater === "function" ? updater(selection) : updater);
+    },
+  });
+
+  const selectedIds = Object.keys(selection).filter((k) => selection[k]);
+  const rows = table.getRowModel().rows;
+
+  // J/K row navigation + Enter/Space to open. Rows are real focus targets (roving).
+  useEffect(() => {
+    if (!onRowOpen) return;
+    const onKey = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey || isTyping(event.target)) return;
+      if (document.querySelector("[role=dialog]")) return;
+      const key = event.key.toLowerCase();
+      if (key !== "j" && key !== "k") return;
+      const desktop = bodyRef.current && bodyRef.current.offsetParent !== null;
+      const container: HTMLElement | null = desktop ? bodyRef.current : mobileRef.current;
+      if (!container) return;
+      const items = Array.from(container.querySelectorAll<HTMLElement>("[data-row]"));
+      if (items.length === 0) return;
+      event.preventDefault();
+      const current = items.indexOf(document.activeElement as HTMLElement);
+      const next = key === "j" ? Math.min(items.length - 1, current + 1) : Math.max(0, current - 1);
+      items[current === -1 ? 0 : next]?.focus();
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [onRowOpen]);
+
+  if (forbidden) {
+    return (
+      <div className="rounded-lg border border-border p-6" data-testid={testId ? `${testId}-forbidden` : undefined}>
+        <p className="text-base font-medium">ليست لديك صلاحية لعرض هذه القائمة</p>
+        <p className="mt-1 text-sm text-muted-foreground">اطلب الصلاحية من مالك المتجر أو مدير الفرع.</p>
+      </div>
+    );
+  }
+
+  const showEmpty = !isLoading && !error && rows.length === 0;
+  const visibleColumns = table.getVisibleLeafColumns();
+
+  return (
+    <div className="flex flex-col gap-3" data-testid={testId}>
+      {toolbar || onDensityChange ? (
+        <div className="flex flex-wrap items-start gap-2">
+          <div className="min-w-0 flex-1">{toolbar}</div>
+          {onDensityChange ? (
+            <button
+              type="button"
+              onClick={() => onDensityChange(density === "comfortable" ? "compact" : "comfortable")}
+              aria-label={density === "comfortable" ? "كثافة مضغوطة" : "كثافة مريحة"}
+              title={density === "comfortable" ? "كثافة مضغوطة" : "كثافة مريحة"}
+              className="hidden size-8 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:flex"
+            >
+              {density === "comfortable" ? (
+                <Rows4 className="size-4" strokeWidth={1.75} aria-hidden />
+              ) : (
+                <Rows3 className="size-4" strokeWidth={1.75} aria-hidden />
+              )}
+            </button>
+          ) : null}
+        </div>
+      ) : null}
+
+      {selectable && selectedIds.length > 0 ? (
+        <div
+          role="region"
+          aria-label="إجراءات جماعية"
+          data-testid="bulk-bar"
+          className="sticky top-0 z-20 flex flex-wrap items-center gap-2 rounded-lg border border-foreground/20 bg-background px-3 py-2"
+        >
+          <span className="text-sm">
+            <Mono>{formatNumber(selectedIds.length)}</Mono> محدد
+          </span>
+          <div className="flex flex-1 flex-wrap items-center gap-1.5">{bulkActions?.(selectedIds)}</div>
+          <button
+            type="button"
+            onClick={() => setSelection({})}
+            aria-label="إلغاء التحديد"
+            className="flex size-11 items-center justify-center rounded-md text-muted-foreground hover:bg-muted lg:size-8"
+          >
+            <X className="size-4" strokeWidth={1.75} aria-hidden />
+          </button>
+        </div>
+      ) : null}
+
+      {error && !isLoading ? (
+        <ErrorState error={error} onRetry={onRetry} />
+      ) : showEmpty ? (
+        isFiltered ? (noResultsState ?? emptyState) : emptyState
+      ) : (
+        <>
+          {/* Desktop/tablet table */}
+          <div
+            className={cn(
+              "relative overflow-x-auto rounded-lg border border-border",
+              renderMobileCard && "hidden md:block",
+              isFetching && !isLoading && "opacity-70 transition-opacity",
+            )}
+          >
+            <table className="w-full border-collapse text-sm" aria-busy={isLoading || isFetching}>
+              <caption className="sr-only">{caption}</caption>
+              <thead className="sticky top-0 z-10 bg-background">
+                {table.getHeaderGroups().map((hg) => (
+                  <tr key={hg.id} className="border-b border-border">
+                    {hg.headers.map((header) => {
+                      const meta = header.column.columnDef.meta;
+                      const sortKey = meta?.sortKey;
+                      const direction =
+                        sortKey && ordering === sortKey ? "asc" : sortKey && ordering === `-${sortKey}` ? "desc" : null;
+                      const content = header.isPlaceholder
+                        ? null
+                        : flexRender(header.column.columnDef.header, header.getContext());
+                      return (
+                        <th
+                          key={header.id}
+                          scope="col"
+                          aria-sort={direction === "asc" ? "ascending" : direction === "desc" ? "descending" : undefined}
+                          className={cn(
+                            "h-9 whitespace-nowrap px-3 text-xs font-normal text-muted-foreground",
+                            meta?.numeric ? "text-end" : "text-start",
+                            meta?.className,
+                          )}
+                        >
+                          {sortKey && onOrderingChange ? (
+                            <button
+                              type="button"
+                              onClick={() => onOrderingChange(nextOrdering(ordering, sortKey))}
+                              className={cn(
+                                "inline-flex h-8 items-center gap-1 rounded-sm hover:text-foreground",
+                                meta?.numeric && "flex-row-reverse",
+                              )}
+                            >
+                              {content}
+                              {direction === "asc" ? (
+                                <ArrowUp className="size-3" aria-hidden />
+                              ) : direction === "desc" ? (
+                                <ArrowDown className="size-3" aria-hidden />
+                              ) : (
+                                <ArrowUpDown className="size-3 opacity-40" aria-hidden />
+                              )}
+                            </button>
+                          ) : meta?.srOnlyHeader && header.column.id !== "__select" ? (
+                            <span className="sr-only">{content}</span>
+                          ) : (
+                            content
+                          )}
+                        </th>
+                      );
+                    })}
+                  </tr>
+                ))}
+              </thead>
+              <tbody ref={bodyRef}>
+                {isLoading
+                  ? Array.from({ length: Math.min(pageSize, 10) }, (_, i) => (
+                      <tr key={i} className="border-b border-border last:border-0">
+                        {visibleColumns.map((c) => (
+                          <td key={c.id} className={cn(ROW_HEIGHT[density], "px-3")}>
+                            <Skeleton className="h-3 w-full max-w-32" />
+                          </td>
+                        ))}
+                      </tr>
+                    ))
+                  : rows.map((row) => (
+                      <tr
+                        key={row.id}
+                        data-row
+                        data-state={row.getIsSelected() ? "selected" : undefined}
+                        tabIndex={onRowOpen ? 0 : undefined}
+                        onKeyDown={(e) => {
+                          if (!onRowOpen || e.target !== e.currentTarget) return;
+                          if (e.key === "Enter" || e.key === " ") {
+                            e.preventDefault();
+                            onRowOpen(row.original);
+                          }
+                        }}
+                        className="border-b border-border outline-none last:border-0 hover:bg-muted/50 focus-visible:bg-muted/70 focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring data-[state=selected]:bg-muted/60"
+                      >
+                        {row.getVisibleCells().map((cell) => {
+                          const meta = cell.column.columnDef.meta;
+                          return (
+                            <td
+                              key={cell.id}
+                              className={cn(
+                                ROW_HEIGHT[density],
+                                "px-3 align-middle",
+                                meta?.numeric ? "text-end font-mono tabular-nums" : "text-start",
+                                meta?.className,
+                              )}
+                            >
+                              {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                            </td>
+                          );
+                        })}
+                      </tr>
+                    ))}
+              </tbody>
+            </table>
+          </div>
+
+          {/* Mobile cards */}
+          {renderMobileCard ? (
+            <ul ref={mobileRef} className="flex flex-col divide-y divide-border rounded-lg border border-border md:hidden">
+              {isLoading
+                ? Array.from({ length: 6 }, (_, i) => (
+                    <li key={i} className="flex flex-col gap-2 p-3">
+                      <Skeleton className="h-3 w-2/3" />
+                      <Skeleton className="h-3 w-1/3" />
+                    </li>
+                  ))
+                : rows.map((row) => (
+                    <li key={row.id} className="flex items-stretch">
+                      {selectable ? (
+                        <label className="flex w-11 shrink-0 items-center justify-center">
+                          <Checkbox
+                            aria-label="تحديد"
+                            checked={row.getIsSelected()}
+                            onCheckedChange={(v) => row.toggleSelected(Boolean(v))}
+                          />
+                        </label>
+                      ) : null}
+                      <div className="min-w-0 flex-1">{renderMobileCard(row.original)}</div>
+                    </li>
+                  ))}
+            </ul>
+          ) : null}
+
+          <TablePagination
+            page={page}
+            pageSize={pageSize}
+            total={total}
+            onPageChange={onPageChange}
+            onPageSizeChange={onPageSizeChange}
+          />
+        </>
+      )}
+    </div>
+  );
+}
+
+/** Sortable header label with the column's own text (keeps column defs terse). */
+export function headerLabel(label: string) {
+  return function Header() {
+    return <>{label}</>;
+  };
+}
diff --git a/src/components/shared/data-table/filter-bar.tsx b/src/components/shared/data-table/filter-bar.tsx
new file mode 100644
index 0000000..e6e676d
--- /dev/null
+++ b/src/components/shared/data-table/filter-bar.tsx
@@ -0,0 +1,236 @@
+"use client";
+
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { Search, SlidersHorizontal, X } from "lucide-react";
+import { Drawer, DrawerContent, DrawerFooter, DrawerHeader, DrawerTitle } from "@/components/ui/drawer";
+import { NativeSelect } from "@/components/ui/native-select";
+import { Mono } from "@/components/shared/mono";
+import { cn } from "@/lib/utils";
+
+/**
+ * Table toolbar parts (T069): a debounced search box and labelled filter selects.
+ * ≥ md the filters sit inline; below md they move into a bottom drawer behind a
+ * «الفلاتر (n)» button (M06 §6 «الفلاتر في drawer سفلي»). Values live in the URL —
+ * these components only report changes.
+ */
+export function SearchBox({
+  value,
+  onChange,
+  placeholder,
+  label = "بحث",
+  delay = 300,
+  className,
+}: {
+  value: string;
+  onChange: (next: string) => void;
+  placeholder: string;
+  label?: string;
+  delay?: number;
+  className?: string;
+}) {
+  const [draft, setDraft] = useState(value);
+  const last = useRef(value);
+  const latestOnChange = useRef(onChange);
+  useEffect(() => {
+    latestOnChange.current = onChange;
+  });
+
+  // External changes (clear filters, back/forward) win over the draft.
+  useEffect(() => {
+    if (value !== last.current) {
+      last.current = value;
+      setDraft(value);
+    }
+  }, [value]);
+
+  useEffect(() => {
+    if (draft === last.current) return;
+    const t = window.setTimeout(() => {
+      last.current = draft;
+      latestOnChange.current(draft);
+    }, delay);
+    return () => window.clearTimeout(t);
+  }, [draft, delay]);
+
+  return (
+    <label className={cn("relative flex min-w-0 items-center", className)}>
+      <span className="sr-only">{label}</span>
+      <Search
+        className="pointer-events-none absolute start-2.5 size-4 text-muted-foreground"
+        strokeWidth={1.75}
+        aria-hidden
+      />
+      <input
+        type="search"
+        value={draft}
+        onChange={(e) => setDraft(e.target.value)}
+        placeholder={placeholder}
+        className="h-11 w-full min-w-0 rounded-lg border border-input bg-background ps-8 pe-8 text-base outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:h-8 md:text-sm dark:bg-input/30 [&::-webkit-search-cancel-button]:hidden"
+      />
+      {draft ? (
+        <button
+          type="button"
+          onClick={() => setDraft("")}
+          aria-label="مسح البحث"
+          className="absolute end-0 flex size-11 items-center justify-center text-muted-foreground hover:text-foreground md:size-8"
+        >
+          <X className="size-3.5" aria-hidden />
+        </button>
+      ) : null}
+    </label>
+  );
+}
+
+export interface FilterOption {
+  value: string;
+  label: string;
+}
+
+export function FilterSelect({
+  label,
+  value,
+  onChange,
+  options,
+  allLabel = "الكل",
+  testId,
+}: {
+  label: string;
+  value: string;
+  onChange: (next: string) => void;
+  options: FilterOption[];
+  allLabel?: string;
+  testId?: string;
+}) {
+  return (
+    <label className="flex min-w-0 flex-col gap-1 md:flex-row md:items-center md:gap-1.5">
+      <span className="text-xs text-muted-foreground md:whitespace-nowrap">{label}</span>
+      <NativeSelect
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        className={cn("h-11 md:h-8 md:w-auto md:min-w-28", value && "border-foreground/40")}
+        data-testid={testId}
+      >
+        <option value="">{allLabel}</option>
+        {options.map((o) => (
+          <option key={o.value} value={o.value}>
+            {o.label}
+          </option>
+        ))}
+      </NativeSelect>
+    </label>
+  );
+}
+
+/**
+ * Inline filters on md+, a bottom drawer below md. `activeCount` labels the mobile button,
+ * `onClear` renders «مسح الفلاتر» when anything is active.
+ */
+export function FilterBar({
+  search,
+  children,
+  activeCount,
+  onClear,
+}: {
+  search?: ReactNode;
+  children: ReactNode;
+  activeCount: number;
+  onClear?: () => void;
+}) {
+  const [open, setOpen] = useState(false);
+  return (
+    <div className="flex flex-col gap-2">
+      <div className="flex items-center gap-2">
+        {search ? <div className="min-w-0 flex-1 md:max-w-sm">{search}</div> : null}
+        <button
+          type="button"
+          onClick={() => setOpen(true)}
+          className="flex h-11 shrink-0 items-center gap-1.5 rounded-lg border border-border px-3 text-sm md:hidden"
+        >
+          <SlidersHorizontal className="size-4" strokeWidth={1.75} aria-hidden />
+          الفلاتر
+          {activeCount > 0 ? <Mono className="text-xs">({activeCount})</Mono> : null}
+        </button>
+      </div>
+      <div className="hidden flex-wrap items-center gap-x-4 gap-y-2 md:flex">
+        {children}
+        {activeCount > 0 && onClear ? (
+          <button
+            type="button"
+            onClick={onClear}
+            className="h-8 rounded-md px-2 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
+          >
+            مسح الفلاتر
+          </button>
+        ) : null}
+      </div>
+      <Drawer open={open} onOpenChange={setOpen}>
+        <DrawerContent>
+          <DrawerHeader>
+            <DrawerTitle>الفلاتر</DrawerTitle>
+          </DrawerHeader>
+          <div className="flex flex-col gap-3 overflow-y-auto p-4">{children}</div>
+          <DrawerFooter className="flex-row">
+            {activeCount > 0 && onClear ? (
+              <button
+                type="button"
+                onClick={onClear}
+                className="h-11 flex-1 rounded-lg border border-border text-sm"
+              >
+                مسح الفلاتر
+              </button>
+            ) : null}
+            <button
+              type="button"
+              onClick={() => setOpen(false)}
+              className="h-11 flex-1 rounded-lg bg-primary text-sm text-primary-foreground"
+            >
+              عرض النتائج
+            </button>
+          </DrawerFooter>
+        </DrawerContent>
+      </Drawer>
+    </div>
+  );
+}
+
+/**
+ * Text-first number strip above a list (constitution I: no equal KPI cards). Each entry
+ * is a filter toggle: «منشور 41 · مسودة 6 · منخفض المخزون 7 · نفد 3».
+ */
+export function StatStrip({
+  items,
+  label,
+}: {
+  label: string;
+  items: Array<{ key: string; label: string; count: number | undefined; active: boolean; onSelect: () => void; tone?: "warning" | "destructive" }>;
+}) {
+  return (
+    <nav aria-label={label} className="-mx-1 flex flex-wrap items-center gap-x-1 gap-y-1 text-sm">
+      {items.map((item, i) => (
+        <span key={item.key} className="flex items-center">
+          {i > 0 ? <span aria-hidden className="px-1 text-border">·</span> : null}
+          <button
+            type="button"
+            onClick={item.onSelect}
+            aria-pressed={item.active}
+            className={cn(
+              "inline-flex min-h-11 items-center gap-1.5 rounded-md px-1.5 transition-colors hover:text-foreground lg:min-h-8",
+              item.active ? "text-foreground underline underline-offset-[6px]" : "text-muted-foreground",
+            )}
+          >
+            {item.label}
+            <Mono
+              className={cn(
+                "text-foreground",
+                item.tone === "warning" && (item.count ?? 0) > 0 && "text-warning",
+                item.tone === "destructive" && (item.count ?? 0) > 0 && "text-destructive",
+              )}
+            >
+              {item.count ?? "–"}
+            </Mono>
+          </button>
+        </span>
+      ))}
+    </nav>
+  );
+}
