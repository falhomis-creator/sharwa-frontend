+++ b/src/features/organization/components/tree-utils.ts
@@ -0,0 +1,124 @@
+import type { Category } from "@/features/organization/schemas";
+
+/**
+ * Flattened-tree helpers for the sortable category tree (dnd-kit "tree" pattern). The
+ * dragged node's descendants are removed from the list while it moves, so a category can
+ * never be dropped inside its own subtree (M05 US-05.1.2) — the server checks it too.
+ */
+export interface FlatNode {
+  id: number;
+  parentId: number | null;
+  depth: number;
+  category: Category;
+  childCount: number;
+}
+
+export function childrenOf(categories: Category[], parentId: number | null): Category[] {
+  return categories.filter((c) => c.parent_id === parentId).sort((a, b) => a.sort_order - b.sort_order || a.id - b.id);
+}
+
+export function flatten(categories: Category[], collapsed: number[] = [], skipIds: Set<number> = new Set()): FlatNode[] {
+  const out: FlatNode[] = [];
+  const walk = (parentId: number | null, depth: number) => {
+    for (const c of childrenOf(categories, parentId)) {
+      if (skipIds.has(c.id)) continue;
+      const kids = childrenOf(categories, c.id);
+      out.push({ id: c.id, parentId, depth, category: c, childCount: kids.length });
+      if (!collapsed.includes(c.id)) walk(c.id, depth + 1);
+    }
+  };
+  walk(null, 0);
+  return out;
+}
+
+export function descendantsOf(categories: Category[], id: number): Set<number> {
+  const out = new Set<number>();
+  const walk = (pid: number) => {
+    for (const c of categories) if (c.parent_id === pid && !out.has(c.id)) {
+      out.add(c.id);
+      walk(c.id);
+    }
+  };
+  walk(id);
+  return out;
+}
+
+export function maxDepth(categories: Category[]): number {
+  return flatten(categories).reduce((m, n) => Math.max(m, n.depth + 1), 0);
+}
+
+/** Where the active node would land given the pointer's horizontal offset (in indents). */
+export function project(
+  items: FlatNode[],
+  activeId: number,
+  overId: number,
+  depthOffset: number,
+): { depth: number; parentId: number | null } | null {
+  const activeIndex = items.findIndex((i) => i.id === activeId);
+  const overIndex = items.findIndex((i) => i.id === overId);
+  if (activeIndex < 0 || overIndex < 0) return null;
+  const moved = [...items];
+  const [active] = moved.splice(activeIndex, 1);
+  moved.splice(overIndex, 0, active!);
+  const prev = moved[overIndex - 1];
+  const next = moved[overIndex + 1];
+  const projected = active!.depth + depthOffset;
+  const max = prev ? prev.depth + 1 : 0;
+  const min = next ? next.depth : 0;
+  const depth = Math.min(Math.max(projected, min), max);
+  let parentId: number | null = null;
+  if (depth > 0 && prev) {
+    if (depth === prev.depth) parentId = prev.parentId;
+    else if (depth > prev.depth) parentId = prev.id;
+    else {
+      const ancestor = moved
+        .slice(0, overIndex)
+        .reverse()
+        .find((i) => i.depth === depth);
+      parentId = ancestor?.parentId ?? null;
+    }
+  }
+  return { depth, parentId };
+}
+
+/**
+ * Apply a move and return every `{id, parent_id, sort_order}` that changed (FR-05.02: one
+ * request with the affected rows only).
+ */
+export function computeMoves(
+  categories: Category[],
+  items: FlatNode[],
+  activeId: number,
+  overId: number,
+  parentId: number | null,
+): { next: Category[]; moves: Array<{ id: number; parent_id: number | null; sort_order: number }> } {
+  const activeIndex = items.findIndex((i) => i.id === activeId);
+  const overIndex = items.findIndex((i) => i.id === overId);
+  const order = [...items];
+  const [active] = order.splice(activeIndex, 1);
+  order.splice(overIndex, 0, active!);
+  // New sibling order under the target parent, following the flattened order.
+  const siblingsAfter = order
+    .filter((n) => (n.id === activeId ? parentId : n.parentId) === parentId)
+    .map((n) => n.id);
+  const next = categories.map((c) => ({ ...c }));
+  const byId = new Map(next.map((c) => [c.id, c]));
+  const moves: Array<{ id: number; parent_id: number | null; sort_order: number }> = [];
+  const oldParent = byId.get(activeId)?.parent_id ?? null;
+  byId.get(activeId)!.parent_id = parentId;
+  siblingsAfter.forEach((id, i) => {
+    const c = byId.get(id)!;
+    const original = categories.find((x) => x.id === id)!;
+    c.sort_order = i;
+    if (original.sort_order !== i || original.parent_id !== c.parent_id) moves.push({ id, parent_id: c.parent_id, sort_order: i });
+  });
+  if (oldParent !== parentId) {
+    childrenOf(next, oldParent).forEach((c, i) => {
+      if (c.sort_order !== i) {
+        c.sort_order = i;
+        moves.push({ id: c.id, parent_id: c.parent_id, sort_order: i });
+      }
+    });
+  }
+  return { next, moves };
+}
diff --git a/src/features/organization/components/undo-delete.ts b/src/features/organization/components/undo-delete.ts
new file mode 100644
index 0000000..45300ab
--- /dev/null
+++ b/src/features/organization/components/undo-delete.ts
@@ -0,0 +1,58 @@
+"use client";
+
+import type { QueryClient, QueryKey } from "@tanstack/react-query";
+import { toast } from "sonner";
+
+/**
+ * FR-05.09: an entity with no products is deleted with a 5-second «تراجع» instead of a
+ * dialog. The row disappears from the cache at once; the request is only sent when the
+ * window closes without an undo, and a failure puts the row back.
+ */
+export function deleteWithUndo<T extends { id: number }>({
+  qc,
+  queryKey,
+  item,
+  label,
+  request,
+  onSettled,
+}: {
+  qc: QueryClient;
+  queryKey: QueryKey;
+  item: T;
+  label: string;
+  request: () => Promise<unknown>;
+  onSettled?: () => void;
+}) {
+  const previous = qc.getQueryData<T[]>(queryKey);
+  qc.setQueryData<T[]>(queryKey, (old) => old?.filter((x) => x.id !== item.id));
+  let undone = false;
+  toast(`حُذف «${label}»`, {
+    duration: 5000,
+    action: {
+      label: "تراجع",
+      onClick: () => {
+        undone = true;
+        qc.setQueryData(queryKey, previous);
+      },
+    },
+  });
+  window.setTimeout(() => {
+    if (undone) return;
+    request()
+      .catch(() => {
+        qc.setQueryData(queryKey, previous);
+        toast.error(`تعذّر حذف «${label}».`);
+      })
+      .finally(() => onSettled?.());
+  }, 5000);
+}
+
+/** Read an image file as a data URL (mock upload; the real adapter sends multipart). */
+export function readAsDataUrl(file: File): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsDataURL(file);
+  });
+}
diff --git a/src/features/organization/schemas.ts b/src/features/organization/schemas.ts
new file mode 100644
index 0000000..9ec0b3a
--- /dev/null
+++ b/src/features/organization/schemas.ts
@@ -0,0 +1,172 @@
+import { z } from "zod";
+
+/**
+ * M05 data contracts (data-model §4 «Organization», discovery 02 §2). Every write row is
+ * `[NEEDS BACKEND]` (contracts/needs-backend-inventory.md §M05); the shapes below are the
+ * PROPOSED `/api/v1/{categories,brands,tags,collections,badges}/` payloads, served today
+ * by `/api/bff/*` from `src/mocks/organization/*`.
+ *
+ * Field limits are the model's own: Category.name 100, Tag.name 60, ProductBadge.name 50,
+ * SEO mixin 70/160/255 (discovery 02 §1).
+ */
+export const SEO_LIMITS = { meta_title: 70, meta_description: 160, meta_keywords: 255 } as const;
+export const CATEGORY_NAME_MAX = 100;
+export const TAG_NAME_MAX = 60;
+export const BADGE_NAME_MAX = 50;
+/** `ProductBadge.color` default (discovery 02 §2). Data, not styling. */
+export const BADGE_DEFAULT_COLOR = "#64748b";
+/** IMAGE_EXTENSIONS (discovery 01 §2.4). */
+export const IMAGE_EXTENSIONS = ["jpg", "jpeg", "png", "webp", "gif"] as const;
+export const IMAGE_EXTENSIONS_MESSAGE = "الصيغ المسموحة: jpg, jpeg, png, webp, gif";
+/** Path separator exactly as the backend renders it («إلكترونيات ⟵ هواتف»). */
+export const PATH_SEPARATOR = " ⟵ ";
+
+const seoFields = {
+  meta_title: z.string().max(SEO_LIMITS.meta_title).default(""),
+  meta_description: z.string().max(SEO_LIMITS.meta_description).default(""),
+  meta_keywords: z.string().max(SEO_LIMITS.meta_keywords).default(""),
+  og_image: z.string().nullable().default(null),
+};
+
+// ── Category ──────────────────────────────────────────────────────────────────────────
+export const categorySchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  parent_id: z.number().int().nullable(),
+  /** [NEEDS BACKEND] proposed — the model has no explicit order today (M05 §10). */
+  sort_order: z.number().int(),
+  image: z.string().nullable(),
+  products_count: z.number().int(),
+  ...seoFields,
+});
+export type Category = z.infer<typeof categorySchema>;
+export const categoryListSchema = z.array(categorySchema);
+
+export const categoryInputSchema = z.object({
+  name: z.string().trim().min(1, "أدخل اسم التصنيف.").max(CATEGORY_NAME_MAX, `الاسم ${CATEGORY_NAME_MAX} حرفاً على الأكثر.`),
+  parent_id: z.number().int().nullable(),
+  image: z.string().nullable(),
+  meta_title: z.string().max(SEO_LIMITS.meta_title, `العنوان ${SEO_LIMITS.meta_title} حرفاً على الأكثر.`),
+  meta_description: z
+    .string()
+    .max(SEO_LIMITS.meta_description, `الوصف ${SEO_LIMITS.meta_description} حرفاً على الأكثر.`),
+  meta_keywords: z.string().max(SEO_LIMITS.meta_keywords, `الكلمات ${SEO_LIMITS.meta_keywords} حرفاً على الأكثر.`),
+  og_image: z.string().nullable(),
+});
+export type CategoryInput = z.infer<typeof categoryInputSchema>;
+
+export const reorderMovesSchema = z.object({
+  moves: z.array(z.object({ id: z.number().int(), parent_id: z.number().int().nullable(), sort_order: z.number().int() })),
+});
+export type ReorderMoves = z.infer<typeof reorderMovesSchema>;
+
+// ── Brand ─────────────────────────────────────────────────────────────────────────────
+export const brandSchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  slug: z.string(),
+  logo: z.string().nullable(),
+  products_count: z.number().int(),
+});
+export type Brand = z.infer<typeof brandSchema>;
+export const brandListSchema = z.array(brandSchema);
+
+// ── Tag ───────────────────────────────────────────────────────────────────────────────
+export const tagSchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  slug: z.string(),
+  products_count: z.number().int(),
+  /** [NEEDS BACKEND] derived — drives «غير مستخدم» (US-05.4.2). */
+  last_used_at: z.string().nullable(),
+});
+export type Tag = z.infer<typeof tagSchema>;
+export const tagListSchema = z.array(tagSchema);
+
+// ── Collection ────────────────────────────────────────────────────────────────────────
+export const collectionProductSchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  sku: z.string(),
+  image: z.string().nullable(),
+  display_price: z.string(),
+  is_archived: z.boolean(),
+});
+export type CollectionProduct = z.infer<typeof collectionProductSchema>;
+
+export const collectionSchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  slug: z.string(),
+  description: z.string(),
+  products_count: z.number().int(),
+});
+export type Collection = z.infer<typeof collectionSchema>;
+export const collectionListSchema = z.array(collectionSchema);
+
+export const collectionDetailSchema = collectionSchema.extend({
+  products: z.array(collectionProductSchema),
+});
+export type CollectionDetail = z.infer<typeof collectionDetailSchema>;
+
+// ── Badge ─────────────────────────────────────────────────────────────────────────────
+export const badgeSchema = z.object({
+  id: z.number().int(),
+  name: z.string(),
+  /** Hex as stored by Django; rendered as data (swatch/dot), never as a class. */
+  color: z.string(),
+  products_count: z.number().int(),
+});
+export type Badge = z.infer<typeof badgeSchema>;
+export const badgeListSchema = z.array(badgeSchema);
+
+/** The three computed badges (discovery 02 §2 `active_badges`) — read-only, never deletable. */
+export const DYNAMIC_BADGES = [
+  { key: "out_of_stock", name: "نفدت الكمية", color: "#dc2626", rule: "حين يصل المخزون إلى صفر." },
+  { key: "on_sale", name: "تخفيض", color: "#16a34a", rule: "حين يكون السعر القديم أعلى من السعر الحالي ضمن نافذة التخفيض." },
+  { key: "new_arrival", name: "وصل حديثاً", color: "#0ea5e9", rule: "خلال 7 أيام من إنشاء المنتج." },
+] as const;
+
+export const HEX_RE = /^#[0-9a-fA-F]{6}$/;
+
+// ── Helpers ───────────────────────────────────────────────────────────────────────────
+/** «إلكترونيات ⟵ هواتف» for a category id, walking `parent_id`. */
+export function categoryPath(id: number | null, byId: Map<number, Category>): string {
+  const parts: string[] = [];
+  const seen = new Set<number>();
+  let cur = id === null ? undefined : byId.get(id);
+  while (cur && !seen.has(cur.id)) {
+    seen.add(cur.id);
+    parts.unshift(cur.name);
+    cur = cur.parent_id === null ? undefined : byId.get(cur.parent_id);
+  }
+  return parts.join(PATH_SEPARATOR);
+}
+
+export function hasImageExtension(fileName: string): boolean {
+  const ext = fileName.split(".").pop()?.toLowerCase() ?? "";
+  return (IMAGE_EXTENSIONS as readonly string[]).includes(ext);
+}
+
+/** WCAG relative-luminance contrast of white text on `hex` (US-05.6.3). */
+export function contrastWithWhite(hex: string): number {
+  if (!HEX_RE.test(hex)) return 21;
+  const channel = (i: number) => {
+    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  };
+  const l = 0.2126 * channel(1) + 0.7152 * channel(3) + 0.0722 * channel(5);
+  return 1.05 / (l + 0.05);
+}
+
+/** Latin slug suggestion; Arabic-only names fall back to the server's suggestion. */
+export function slugify(input: string): string {
+  return input
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[^a-z0-9\s-]/g, "")
+    .trim()
+    .replace(/[\s_]+/g, "-")
+    .replace(/-+/g, "-")
+    .slice(0, 60);
+}
diff --git a/src/features/products/api/products.ts b/src/features/products/api/products.ts
