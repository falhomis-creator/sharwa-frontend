# Copy to .env.local — never commit real values.
# Base domain for tenant resolution: stores live at <store>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost

# Django origin reachable from the Next server (read-only backend, same-origin BFF proxies to it)
API_INTERNAL_URL=http://localhost:8000
# Optional override for split environments
# API_PROXY_URL=

# Platform support WhatsApp (international format, digits only)
NEXT_PUBLIC_PLATFORM_WHATSAPP=967700000000

# on  → BFF adapters serve local mocks for [NEEDS BACKEND] contracts (default in dev)
# off → 501 {"detail":"غير متاح بعد"} (default in production)
SHARWA_MOCKS=on

# Integrated modules that call Django even while SHARWA_MOCKS=on (comma-separated, `*` = all).
# Needs a real Django dashboard session on the same store host (log in once at
# http://<store>.localhost:8000/dashboard/login/ — cookies are shared across ports).
# Modules: reports · catalog (M05 organization) · products (M04 products, dictionary, templates,
# sectors — Phase A; see src/lib/bff/live-products.ts) · orders (M06 list, detail, actions, refunds,
# manual orders, fulfilment statuses — api/views_orders.py) · search (M48 ⌘K palette — api/views_search.py)
# · notifications (M49 bell + panel — api/views_notifications.py) · settings (M34 store settings —
# api/views_settings.py) · pwa (M44 merchant push card: push/stats, push/test — api/views_push.py;
# the storefront PWA rows are the /api/v1 passthrough, Django-first) · customers (M07 list, profile, tabs,
# notes, COD, review replies, export — api/views_customers.py) · design (M08 theme, presets, announcement,
# home sections — api/views_design.py) · marketing (M13 coupons, offers, abandoned carts, campaigns,
# timeline, loyalty, gifting — api/views_marketing.py) · payments (M14 gateways, payout accounts, wallet,
# withdrawals, dues — api/views_payments.py) · shipping (M15 fees, delivery methods, pickup points,
# couriers/carriers, zones, packaging, zone review, restricted zones, SLA, edge cases, address update,
# convert-to-pickup — api/views_shipping.py) · staff (M18 staff, roles, permissions, assignments,
# overrides, sessions/tokens/devices/roster, approvals, audit log, behavior alerts — api/views_staff.py).
# platform (M20 console on console.<base> — INT-030: auth/login/logout/me, overview, stores, clients,
# re-provision, Sharwa Ship, per-store features, domains, deactivation lifecycle, features catalog +
# kill switch, resolve, feature overrides, webhook events — api/views_platform.py; Django admin users:
# superuser = owner, is_staff = operator) · platform_money (M45 console — INT-031: dues overview/detail +
# the 8 dues actions, Sharwa Pay top-ups/withdrawals/wallets, Sharwa Ship zones — same views; operators may
# act on dues and Sharwa Pay) · platform_billing (M46 console — INT-032: plans, plan × feature matrix,
# subscriptions + assign, the two billing switches, app catalogue + billing overrides, market categories)
# · pos (M16 POS — INT-033: registers, shifts, cash movements, sale + receipts, refund + OTP step-up —
# api/views_pos.py; plan feature `pos`) · affiliates (M17 — INT-034: affiliates + influencers lists,
# summary, sales, mark-paid — api/views_partners.py; the storefront `?aff_id=` click is Django-first)
# · procurement (M23 — INT-035: suppliers CRUD + purchase orders draft/submit/resolve/receive/cancel —
# api/views_procurement.py) · bookings (M26 — INT-036: bookable services, availability windows, calendar,
# cancel — api/views_bookings.py; plan feature `bookings`; the buyer's slots + hold are Django-first) · channels
# (M27 — INT-037: unified inbox + channel settings: connections, Telegram, Meta/TikTok OAuth, keywords, reply
# templates, catalog sync, TikTok category mapping, staff access — api/views_channels.py; plan feature `social_channels`)
# · marketplaces (M28 — INT-038: Amazon/noon connection, settings, listings + push, sync jobs + errors CSV, marketplace
# orders + shipment re-confirmation — api/views_marketplaces.py; plan feature `marketplaces`)
# · dropshipping (M29 — INT-039: supplier connections + sync settings + webhook rotation, pricing rules + simulation +
# apply, supplier catalog + import, flat feeds upload/link → mapping → preview → approve → run + errors CSV, supplier
# orders + resubmit, sync jobs + retry — api/views_dropshipping.py; plan feature `dropshipping`)
# · apps (M30 — INT-040: app catalogue + install/activate/deactivate, lifecycle events, app fees, WhatsApp usage log +
# summary + templates + SharwaConnect link — api/views_apps.py; plan feature `app_marketplace`; `sharwa-ai/*` stays on
# its own switch `sharwa_ai`)
# · sharwa_ai (M31 — INT-041: WhatsApp pairing status + QR + reconnect, bot settings, console SSO token —
# api/views_sharwa_ai.py; plan feature `app_marketplace`; the console token needs Django's SHARWA_AI_CONSOLE_URL + SSO keys).
# · support (M31/M32 — INT-042: live support sessions + timeline + takeover/release/close/reply with `version` and
# `client_id`, support tickets + counters + assignees — api/views_support.py; no plan feature, takeover rows need
# `support.takeover_session`).
# · expenses (M33 — INT-043: operating-expense ledger grouped by month with per-currency totals + create —
# api/views_expenses.py; no plan feature, `expenses.manage` (Django migration 0235) or the owner).
# · b2b (M36 — INT-044: the draft form's choices `orders/b2b-options/` + the product editor's quantity prices
# `products/<id>/tier-prices/` — api/views_b2b.py; the drafts themselves are the /api/v1 passthrough, Django-first).
# · advanced_products (M37 — INT-045: the product editor's bundle components, compatibility rules, personalization fields,
# auction + bids, serials, and the CSV import (upload → mapping → run, polled) / export — api/views_product_extras.py;
# the storefront auction + bids are Django-first through the storefront adapter, no switch needed).
# · courier (M38 — INT-046: the courier app's reads me/shipments/shipment/custody — api/views_courier.py; the staff
# session whose shipping_provider_profile is the agent; the five actions are the /api/v1/agent/* passthrough, Django-first).
# · sharwa_ship (M39 — INT-047: pending orders + waybill issue, shipments list/detail/manual status/assign, AWB queue + retry,
# rate cards, courier supervision + emergency reassign + shifts — api/views_sharwa_ship.py; feature `sharwa_ship`, the
# supervision rows also open with local delivery `shipping_providers`; the zones list stays on `shipping`).
# · sharwa_pay (M40 — INT-048: the customer wallet on the PLATFORM origin — WhatsApp OTP login, wallet, transactions,
# requests, top-up with receipt, withdrawal — api/views_sharwa_pay.py, public schema; credits stay the console's call).
# · rollup (M43 — INT-049: «متاجري» + the topbar store switcher — api/views_rollup.py; the MerchantAccount linked to
# this store, public TenantStatsSnapshot rows per range, owner only).
# Each can be switched on independently.
# SHARWA_LIVE_MODULES=reports,catalog,products,orders,search,notifications,settings,pwa,customers,design,marketing,payments,shipping,staff,integrations,platform,platform_money,platform_billing,pos,affiliates,procurement,bookings,channels,marketplaces,dropshipping,apps,sharwa_ai,support,expenses,b2b,advanced_products,courier,sharwa_ship,sharwa_pay,rollup
