# Copy to .env.local — never commit real values.
# Base domain for tenant resolution: stores live at <store>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost

# Django origin reachable from the Next server (read-only backend, same-origin BFF proxies to it)
API_INTERNAL_URL=http://localhost:8000
# Optional override for split environments
# API_PROXY_URL=

# Platform support WhatsApp (international format, digits only)
NEXT_PUBLIC_PLATFORM_WHATSAPP=967700000000

# on  → BFF adapters serve local mocks for [NEEDS BACKEND] contracts (default in dev)
# off → 501 {"detail":"غير متاح بعد"} (default in production)
SHARWA_MOCKS=on

# Integrated modules that call Django even while SHARWA_MOCKS=on (comma-separated, `*` = all).
# Needs a real Django dashboard session on the same store host (log in once at
# http://<store>.localhost:8000/dashboard/login/ — cookies are shared across ports).
# Modules: reports · catalog (M05 organization) · products (M04 products, dictionary, templates,
# sectors — Phase A; see src/lib/bff/live-products.ts). Each can be switched on independently.
# SHARWA_LIVE_MODULES=reports,catalog,products
